model ShippingQuote {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The dock this price was asked for.
  ///
  /// A quote is a price for a parcel leaving a particular address, so an order
  /// whose goods sit at two docks needs two answers — and a booking must not
  /// spend a price that was quoted from the other one. Null only on quotes
  /// written before origins reached this path; the booking gate treats a null
  /// as "unknown dock" and refuses it rather than assuming the only one.
  originLocationId  String?
  originLocation    PickupLocation? @relation("QuoteOrigin", fields: [originLocationId], references: [id], onDelete: SetNull)
  provider          String          @default("eshipper")
  /// The provider's own quote id, when returned. Required to book via
  /// POST /api/v2/ship/{quoteId}; null for a locally-simulated quote.
  providerQuoteId   String?
  carrier           String
  serviceCode       String
  serviceName       String
  totalAmount       Int
  currency          String          @default("CAD")
  transitDays       Int?
  estimatedDelivery DateTime?
  quotedAt          DateTime        @default(now())
  expiresAt         DateTime?
  selected          Boolean         @default(false)
  raw               String?
  createdAt         DateTime        @default(now())

  @@index([orderId])
}

model OrderPackage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  length    Float
  width    Float
  height    Float
  weight    Float
  units     String   @default("cm_kg")
  /// The shipment this package was booked on, when one took it.
  ///
  /// NULL means "on the order, not yet on a booking" — which is the state of
  /// every row written before this column existed, and stays legal afterwards.
  /// A shipment reads its OWN parcels from here rather than being handed the
  /// whole order's list, so a split order cannot tell a carrier about a box
  /// that is not in the one being booked.
  ///
  /// ON DELETE SET NULL, not CASCADE: losing a shipment record must not delete
  /// the description of a parcel that was measured and may still be shipped.
  shipmentId String?
  shipment   Shipment? @relation("ShipmentPackages", fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([shipmentId])
}

model PaymentEvent {
  id           String            @id @default(cuid())
  provider     String            @default("stripe")
  eventId      String            @unique
  type         String
  paymentId    String?
  payment      WholesalePayment? @relation(fields: [paymentId], references: [id])
  payload      String
  status       String            @default("PROCESSED")
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([paymentId])
  @@index([type])
}

model FulfillmentRequest {
  id                        String                   @id @default(cuid())
  orderId                   String                   @unique
  order                     Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyFulfillmentOrderId String?
  status                    FulfillmentRequestStatus @default(PENDING)
  requestedAt               DateTime                 @default(now())
  acceptedAt                DateTime?
  rejectedAt                DateTime?
  rejectReason              String?
  closedAt                  DateTime?
  updatedAt                 DateTime                 @updatedAt
}

model IntegrationState {
  id             String            @id @default(cuid())
  key            String            @unique
  status         IntegrationStatus @default(NOT_CONFIGURED)
  lastSuccessAt  DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  detail         String?
  updatedAt      DateTime          @updatedAt
  /**
   * Set by an operator's Disconnect. While it is set, credential resolution
   * refuses every source for this key — including the environment — so the
   * provider cannot be reached again until someone saves credentials anew.
   * Without this, disconnecting would only change a displayed status while the
   * environment quietly kept the provider live.
   */
  disconnectedAt DateTime?
}

/**
 * Operator-supplied provider credentials, stored encrypted at rest.
 * `value` is always AES-256-GCM ciphertext (see services/credentials.server.ts);
 * plaintext is never written to this table and never leaves the server. An
 * absent row means "not configured here", which lets credential resolution fall
 * back to the environment for deployments that configure providers that way.
 */
model IntegrationCredential {
  id        String   @id @default(cuid())
  key       String
  field     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, field])
  @@index([key])
}

model AnalyticsSnapshot {
  id           String    @id @default(cuid())
  shop         String
  source       String
  periodStart  DateTime?
  periodEnd    DateTime?
  coverage     String
  metrics      String    @default("{}")
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shop, source])
  @@index([shop])
}

/// Durable failed-sign-in counter. Survives a container restart, unlike the
/// in-memory map it replaces. Rows are pruned once they fall outside the window.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Idempotency ledger for externally-triggered work (Shopify webhooks, Odoo
/// writes, payment debits, shipment creation). A row is claimed before the work
/// is attempted, so a redelivered webhook or a retried request cannot create a
/// second Odoo order, payment or label.
/// Durable idempotency ledger.
///
/// Deliberately in the database rather than in process memory. The failure this
/// exists to prevent — a retry turning into a second charge against a payer's
/// bank account — most often follows a crash, a deploy, or a timeout. An
/// in-memory guard is empty in precisely that moment, so it would protect only
/// the cases that were already safe.
model IdempotencyKey {
  id          String    @id @default(cuid())
  scope       String
  key         String
  /// SHA-256 of the request parameters. Same key + different parameters is a
  /// conflict, not a replay, and must be reported rather than silently reused.
  fingerprint String
  status      String    @default("IN_PROGRESS")
  /// The recorded outcome, replayed to the caller on a repeat call.
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([scope, key])
  @@index([scope, status])
  @@index([createdAt])
}

/// A Canadian Pre-Authorized Debit mandate.
///
/// Persisted so that the mandate state machine survives a restart. `CANCELLED`
/// is terminal: a payer who revoked authorization must not be debitable because
/// the process that knew about the revocation was recycled.
model PadMandate {
  id                String   @id @default(cuid())
  sellerId          String
  state             String
  reference         String?
  payerName         String
  /// Last four digits only. Full account and transit numbers are never stored.
  accountLast4      String?
  institutionNumber String?
  transitNumber     String?
  accountType       String
  /// True when produced without contacting the provider. Never debitable.
  simulated         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerId])
  @@index([state])
}

/**
 * ==========================================================================
 */
/**
 * Product / variant / media
 */
/**
 * ==========================================================================
 */

/// Lifecycle of a product family, independent of whether sellers can see it.
///
/// `isActive`/`isPublished`/`isArchived` predate this and are retained for the
/// merchant-facing queries that already read them; `status` is the single
/// editorial state the admin interface drives. The publication gate is what
/// keeps the two consistent — nothing sets PUBLISHED without passing it.
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

/// What an asset is for. Drives which tab it appears under and which subtype
/// values are legal for it.
enum MediaCategory {
  WHITE_BACKGROUND_IMAGE
  LIFESTYLE_IMAGE
  PRODUCT_VIDEO
  DOCUMENT
  MARKETING_CREATIVE
  EDITABLE_TEMPLATE
}

/// The finer classification within a category.
///
/// One enum across every category rather than one per category: the upload and
/// approval paths are shared, so a single column keeps the "is this asset
/// publishable" question answerable without a join per type. Values are grouped
/// below by the category they belong to, and the pairing is validated in
/// app/services/media.server.ts.
enum MediaSubtype {
  // WHITE_BACKGROUND_IMAGE
  WHITE_BACKGROUND
  // LIFESTYLE_IMAGE
  LIFESTYLE
  // PRODUCT_VIDEO
  PRODUCT_DEMO
  LIFESTYLE_VIDEO
  SOCIAL_CLIP_VERTICAL // 9:16
  SOCIAL_CLIP_SQUARE // 1:1
  // DOCUMENT
  CARE_GUIDE
  SPECIFICATION_SHEET
  WARRANTY
  CERTIFICATION
  PACKAGING_INSTRUCTIONS
  MARKETING_PDF
  OTHER_DOCUMENT
  // MARKETING_CREATIVE / EDITABLE_TEMPLATE
  SQUARE_POST // 1080 x 1080
  STORY_REEL // 1080 x 1920
  BANNER // 1600 x 600
  LANDSCAPE_AD
  SOCIAL_VIDEO
  EDITABLE_TEMPLATE
}

/// Where an upload is in its lifecycle. A seller never sees anything that is
/// not READY, whatever its approval state.
enum ProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// Editorial approval, separate from processing. DRAFT is the initial state and
/// is not a synonym for "not yet processed" — a DRAFT asset may be perfectly
/// READY and simply not yet reviewed.
enum ApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// The kinds of PDF a product can carry.
enum DocumentType {
  CARE_GUIDE
  SPECIFICATION_SHEET
  WARRANTY
  CERTIFICATION
  PACKAGING_INSTRUCTIONS
  MARKETING_PDF
  OTHER
}

/// One uploaded file, and every fact about it that is independent of which
/// variants it is shown for.
///
/// Documents and marketing creatives are rows in THIS table, not tables of
/// their own, which is why the document-only and marketing-only columns below
/// are nullable. The alternative — three asset tables — would mean three upload
/// paths, three approval paths and three implementations of the "which variants
/// does this apply to" rule, and the directive is explicit that a file shared
/// between variants is stored once. Type-specific fields are set only for the
/// category that owns them; app/services/media.server.ts enforces the pairing
/// so a DOCUMENT cannot carry a banner's dimensions.
model MediaAsset {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  MediaCategory
  subtype   MediaSubtype?
  title     String
  /// Required before publication. Enforced by the readiness checklist rather
  /// than by a NOT NULL, because an asset is legitimately created before its
  /// alt text is written.
  altText   String?

  /// What the uploader called it. Display only, never used to build a path.
  originalFilename String
  /// The opaque object key in the storage backend. Random, extension-less
  /// enough to carry no meaning, and unique so two uploads cannot collide.
  storageKey       String @unique
  mimeType         String
  fileSize         Int
  /// sha256 of the stored bytes. Used for duplicate detection and integrity.
  checksum         String

  /// Where the asset came from, for rows migrated out of the old flat model
  /// that stored a remote URL instead of a stored object. The bytes were never
  /// in our storage, so the migration cannot import them; keeping the URL means
  /// the original is still findable and the migration is not lossy. Null for
  /// anything uploaded through the normal pipeline.
  sourceUrl String?

  width           Int?
  height          Int?
  durationSeconds Int?
  aspectRatio     String?

  processingStatus ProcessingStatus @default(UPLOADING)
  approvalStatus   ApprovalStatus   @default(DRAFT)
  /// Seller visibility is a separate switch from approval on purpose: an
  /// approved asset may still be held back from the Media Kit.
  sellerVisible    Boolean          @default(false)

  /// Video poster frame, stored as its own object.
  posterStorageKey String?

  // --- DOCUMENT only -------------------------------------------------------
  documentType  DocumentType?
  /// Human version label ("1.2"), not a sequence. History is preserved by
  /// keeping the superseded row and pointing the replacement at it.
  version       String?
  effectiveDate DateTime?
  language      String?
  /// When set, this asset supersedes that one. The superseded row is never
  /// deleted, so old versions stay traceable.
  supersedesId  String?

  // --- MARKETING_CREATIVE / EDITABLE_TEMPLATE only -------------------------
  downloadAllowed Boolean @default(true)
  instructions    String?
  /// An approved external link for an editable template. Validated as https.
  templateUrl     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supersedes   MediaAsset?            @relation("AssetSupersession", fields: [supersedesId], references: [id])
  supersededBy MediaAsset[]           @relation("AssetSupersession")
  assignments  MediaAssetAssignment[]

  @@index([productId, category])
  @@index([checksum])
  @@index([approvalStatus])
}

/// Which variants an asset is shown for.
///
/// `variantId = null` means the asset is shared with every variant of the
/// product. A non-null row means it applies to that one variant; assigning to
/// several variants writes several rows pointing at the SAME asset, so the file
/// is stored once however many variants use it.
model MediaAssetAssignment {
  id        String          @id @default(cuid())
  assetId   String
  asset     MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  /// The image actually used for this variant. A primary on a shared row is the
  /// fallback used when the variant has no primary of its own; a primary on a
  /// variant row overrides it.
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())

  /// One row per (asset, scope). Re-assigning is idempotent.
  @@unique([assetId, variantId])
  @@index([variantId, sortOrder])
}

/// Ordered option name/value pairs on a variant — "Size: Queen", "Colour:
/// White". Ordered because the interface shows them in the order entered, and
/// because the SKU suggestion is built from them.
///
/// This replaces the single `optionName`/`optionValue` pair that the flat model
/// used, which could express only one axis.
model VariantOption {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int            @default(0)

  @@unique([variantId, name])
  @@index([variantId, sortOrder])
}

/// A merchant's copy of a MoonVella product in an external storefront.
///
/// Kept per shop rather than on the product, because the same product is
/// imported by several merchants and each import has its own identity, status
/// and failure history. `lastSyncError` is deliberately free text that must
/// never be given a token or credential to quote — see the audit rules.
model ExternalProductMapping {
  id                String               @id @default(cuid())
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "SHOPIFY" for a merchant's storefront copy, "ODOO" for the source catalog.
  /// An ODOO row keeps the Odoo database name in `shopDomain`, which is the
  /// tenant that owns the record — not a shop domain, but the same question
  /// ("which system's copy is this?") with the same answer shape.
  provider          String               @default("SHOPIFY")
  shopDomain        String
  externalProductId String?
  importStatus      String               @default("NOT_IMPORTED")
  lastSyncedAt      DateTime?
  lastSyncError     String?
  /// Archiving state in the merchant's Shopify store, tracked per product so
  /// the owner gets real counts instead of a promise. Only ever ARCHIVED or
  /// FAILED for a product this app imported; never set by a title or vendor
  /// match.
  archiveStatus     ProductArchiveStatus @default(NOT_APPLICABLE)
  archiveAttempts   Int                  @default(0)
  archiveLastError  String?
  archivedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([provider, shopDomain, productId])
  @@index([shopDomain])
  @@index([archiveStatus])
}

/// The variant-level counterpart of ExternalProductMapping. The Shopify variant
/// id is the one the merchant's inventory is keyed on, so this row — not the
/// product row — is what a future inventory sync reconciles against.
model ExternalVariantMapping {
  id                String         @id @default(cuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  provider          String         @default("SHOPIFY")
  shopDomain        String
  externalProductId String?
  externalVariantId String?
  importStatus      String         @default("NOT_IMPORTED")
  lastSyncedAt      DateTime?
  lastSyncError     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([provider, shopDomain, variantId])
  @@index([shopDomain])
}

/// Per-seller branding used when generating marketing material.
///
/// Nothing reads this yet. It exists now because the Marketing Pack generator
/// has to be written against a shape, and retrofitting the seller's brand into
/// generated assets after merchants have downloaded them is not possible.
model SellerBrandKit {
  id             String   @id @default(cuid())
  sellerId       String   @unique
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeName      String?
  /// Object key of the seller's logo, in the same storage backend as media.
  logoStorageKey String?
  callToAction   String?
  /// JSON object of named colours, e.g. {"primary":"#1B4D3E"}. A free-form map
  /// because brands do not agree on a palette size.
  brandColours   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Where one seller exists in Odoo.
///
/// One row per (seller, role). The uniqueness is the point: a retry, a
/// reapplication or a second approval click updates THIS row rather than
/// creating a second Odoo partner, which is the failure mode that turns a
/// contact list into a duplicate list.
///
/// Nothing here is ever matched by email or tax id to decide whether to merge.
/// The mapping is the authority; matching is only used to refuse a write that
/// would collide with an unrelated record.
model ExternalContactMapping {
  id                 String            @id @default(cuid())
  sellerId           String
  seller             Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  role               ContactRole
  /// The Odoo res.partner id. Null until a write succeeds — a PENDING mapping
  /// with a null id is a promise, not a record, and the interface says so.
  odooPartnerId      Int?
  /// What the record was called when it was written, so a later run can say
  /// "renamed from X" instead of silently overwriting.
  odooName           String?
  status             ContactSyncStatus @default(PENDING)
  attempts           Int               @default(0)
  lastError          String?
  lastAttemptAt      DateTime?
  syncedAt           DateTime?
  /// SHA-256 of the mapped field set. When it is unchanged, a retry is a no-op
  /// and says so, rather than issuing a write that would churn Odoo's audit
  /// trail on every reapplication.
  payloadFingerprint String?

  // --- identity, held here rather than in Odoo -------------------------
  // The store's own identifiers. They are NOT written into the Odoo partner:
  // `ref` is a reference field that already means something to whoever set it,
  // and overloading it with a Shopify id would make the one field a reader
  // trusts the one field that lies. Each identifier gets its own column here,
  // on the record whose whole purpose is to be the durable link between the
  // two systems.
  /// The Shopify store display name at the time of the sync.
  storeName       String?
  /// `gid://shopify/Shop/…`. Survives a myshopify domain change.
  shopifyShopId   String?
  myshopifyDomain String?
  /// The resolved tag id used, so a later run can tell that the tag was
  /// re-created under a different id and needs re-applying.
  odooTagId       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sellerId, role])
  @@index([status])
}

/// Deferred work: see JobStatus for why this exists.
model BackgroundJob {
  id                  String    @id @default(cuid())
  /// "ODOO_CONTACT_SYNC" | "SHOPIFY_PRODUCT_ARCHIVE"
  kind                String
  sellerId            String?
  seller              Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  payload             Json?
  status              JobStatus @default(PENDING)
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  lastError           String?
  /// When the job becomes eligible. A failure pushes this forward (backoff)
  /// instead of spinning.
  runAt               DateTime  @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  /// The seller.accessVersion at queue time. A job whose version no longer
  /// matches is cancelled, not run.
  sellerAccessVersion Int?
  /// Human-readable progress for the owner panel, e.g. archive counts.
  result              Json?
  /// Same key queued twice is one job. Prevents a double-clicked Block from
  /// queueing two archive passes.
  idempotencyKey      String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, runAt])
  @@index([kind, status])
  @@index([sellerId])
}

/// A place MoonVella collects from — the shared address record an origin
/// mapping points at.
///
/// WHY THIS IS ITS OWN RECORD. The directive requires the address to exist once
/// and be referenced, not copied onto every product: a dock's phone number
/// changes, and a copy per product means every copy is a chance to miss one.
/// So this row owns the address, the contact, the hours and the access notes,
/// and products and variants point at it.
///
/// THE ODOO IDS ARE THE POINT OF THE MAPPING. A pickup location is not a
/// MoonVella invention — it is a warehouse or stock location that already
/// exists in Odoo, and the four id columns are how this row is tied to it. They
/// are nullable because an address may be captured before the Odoo side is
/// confirmed, but a row with no Odoo identity is reported as unmapped rather
/// than silently treated as authoritative.
///
/// `odooDatabase` scopes the ids: two Odoo databases both have a location with
/// id 25, and a mapping that does not say which database it came from will
/// resolve to the wrong one the moment a second database is connected.
model PickupLocation {
  id   String @id @default(cuid())
  /// Stable, human-typed reference used on screens and in the audit trail.
  code String @unique
  name String

  // --- Odoo identity ------------------------------------------------------
  odooDatabase    String?
  odooCompanyId   Int?
  odooWarehouseId Int?
  odooLocationId  Int?
  /// The `res.partner` behind the address, when Odoo models it as one.
  odooPartnerId   Int?

  // --- contact ------------------------------------------------------------
  contactName  String?
  contactPhone String?
  contactEmail String?

  // --- address, structured ------------------------------------------------
  street1    String?
  street2    String?
  city       String?
  province   String?
  postalCode String?
  country    String?

  // --- operating window ---------------------------------------------------
  /// IANA zone, e.g. "America/Toronto". Pickup times below are in THIS zone,
  /// which is not necessarily the server's or the seller's — a dock that
  /// closes at 16:00 closes at 16:00 where the dock is.
  timeZone           String?
  /// "HH:MM" in `timeZone`.
  pickupOpenTime     String?
  pickupCloseTime    String?
  /// Free text the driver needs: gate code, ship-at-door, appointment required.
  instructions       String?
  /// Requirements for the carrier to collect at all — dock height, forklift,
  /// tail-lift, appointment windows.
  accessRequirements String?

  /// The ONE location every outbound shipment starts from when neither the
  /// variant nor the product names its own.
  ///
  /// This is not the "global default" a product's null `pickupLocationId` is
  /// warned about. That warning is about inventing an address for an item nobody
  /// has said where it ships from; this is the opposite — an operator has named
  /// one dock as where stock physically leaves, and the row carries the raw
  /// Odoo address rather than a copy of it. A per-product or per-variant mapping
  /// still wins, and a product with a genuinely different origin keeps saying so.
  isDefault Boolean @default(false)

  /// The weekdays this dock works, as ISO numbers joined with commas — 1 is
  /// Monday, 7 is Sunday. `'1,2,3,4,5'` is the default and `''` is a real
  /// answer meaning this dock is never open.
  ///
  /// A STRING, not a set of booleans and not an array, because it is one
  /// calendar fact about one place and it is read and written as one value by
  /// one form. See `holidays.server.ts` for the parser, and for why a pickup
  /// proposal is built from these and not from `pickupOpenTime`.
  workingDays String @default("1,2,3,4,5")

  /// How many days' notice a collection at this dock needs. NULL means no lead
  /// time is configured — not zero, and not "impossible".
  leadTimeDays Int?

  /// "HH:MM" in this dock's own `timeZone`: the time after which today can no
  /// longer be collected. NULL means no same-day cutoff is configured.
  ///
  /// Separate from `leadTimeDays` because they are separate facts — a dock with
  /// a 10:00 same-day deadline still has to be open that day, and a dock with a
  /// two-day lead time may have no same-day option at all.
  sameDayDeadline String?

  /// Dated exceptions to this dock's normal week and to the computed statutory
  /// calendar. Only the DIFFERENCES are stored; see `LocationHoliday`.
  holidays LocationHoliday[]

  /// How parcels leave this dock by default: NEEDED (call a truck), REGULAR (a
  /// standing collection already comes here), DROPOFF (handed in at the
  /// carrier's depot, so no collection is involved).
  ///
  /// A dock with a standing collection is the case a one-off pickup request gets
  /// wrong: the truck that already comes will take the parcel, and booking a
  /// second collection for the same door is how two drivers arrive for one box.
  /// The parcel records the answer it was prepared under; this is the default.
  pickupMode String @default("NEEDED")

  /// The most recent Google Address Validation verdict for this address, and
  /// when it was reached. Kept on the row so a screen can say "this address has
  /// never been checked" without calling Google on every render.
  addressVerdict        AddressVerdict @default(UNVALIDATED)
  addressCheckedAt      DateTime?
  /// True when an owner has explicitly accepted an address Google could not
  /// resolve. An overridden address is never described as Google validated.
  addressOverridden     Boolean        @default(false)
  addressOverrideReason String?

  isActive        Boolean          @default(true)
  products        Product[]        @relation("ProductPickupLocation")
  variants        ProductVariant[] @relation("VariantPickupLocation")
  shipmentOrigins Shipment[]
  quotedFrom      ShippingQuote[]  @relation("QuoteOrigin")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive])
  @@index([odooDatabase, odooLocationId])
  @@index([isDefault])
}

/// A DATED EXCEPTION at one dock — a day it is open when the calendar says
/// closed, closed when the calendar says open, or open for different hours.
///
/// WHY THIS TABLE IS SMALL AND NOT A CALENDAR. The statutory calendar is
/// COMPUTED from the year (`holidays.server.ts`), so it is correct for any year
/// without anybody typing it in and it cannot be half-entered. Storing it would
/// mean two sources for one date, and the day they disagreed the proposal would
/// silently use whichever it happened to read first. What is stored here is only
/// what the computation cannot know: the owner's own decisions about this dock.
///
/// `date` IS A CALENDAR STRING, "YYYY-MM-DD", and never a timestamp. A closure
/// on 2026-12-25 is a fact about a DATE, not about an instant; as a timestamp it
/// would be the 24th in one zone and the 26th in another, and the closure would
/// fall on the wrong day for whoever read it. The form writes what a date input
/// gives it, which is already this string.
model LocationHoliday {
  id         String        @id @default(cuid())
  locationId String
  location   PickupLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD", in the dock's own local calendar.
  date       String
  /// OPEN_ON_HOLIDAY · EXTRA_CLOSURE · SPECIAL_HOURS
  kind       String
  /// What to call it on screen: "Inventory count", "Open for the truck".
  name       String?
  /// "HH:MM" in the dock's zone. Ignored for the two closure kinds; this is the
  /// entire content of SPECIAL_HOURS.
  openTime   String?
  closeTime  String?
  createdAt  DateTime      @default(now())

  /// One row per date per kind. A dock may be open on a holiday AND have special
  /// hours that day, but it may not record the same closure twice — a duplicate
  /// is two rows that can be deleted independently, which is how a closure comes
  /// back by accident.
  @@unique([locationId, date, kind])
  @@index([locationId, date])
}

/// The verdict of an address check, for both origin and delivery addresses.
///
/// The four states are the directive's, and the last two are the ones that get
/// collapsed by accident: `UNAVAILABLE` is Google not answering — which must
/// NEVER be recorded as acceptable — and `OVERRIDDEN` is an owner having read
/// the problem and taken responsibility for it, with a reason on the record.
enum AddressVerdict {
  UNVALIDATED
  ACCEPTED
  CONFIRMATION_REQUIRED
  CORRECTION_REQUIRED
  UNAVAILABLE
  OVERRIDDEN
}

/// One address validation result, kept as evidence.
///
/// WHAT IS NOT STORED: the Google response. Google's terms restrict how long a
/// response may be retained and what may be cached, so this row holds the
/// verdict, the address as Google would normalise it, the component-level
/// corrections the reader needs to see, and the place id — not the payload.
///
/// THE INPUT HASH IS HOW DUPLICATE CALLS ARE AVOIDED. Validating an address is
/// a billable call, and a page that validates on every render pays for the same
/// address repeatedly. A row is reused while the hash of the structured input
/// is unchanged; a material edit changes the hash and forces a fresh check.
model AddressValidation {
  id                String         @id @default(cuid())
  /// What was validated: a PickupLocation, or an Order's delivery address.
  subjectType       String
  subjectId         String
  /// SHA-256 over the normalised structured input. A different hash is a
  /// different address and needs its own verdict.
  inputHash         String
  verdict           AddressVerdict
  /// The address as typed, and as Google would have it. Both are kept so the
  /// interface can show them side by side and a person decides which is right.
  originalAddress   Json
  suggestedAddress  Json?
  /// Component-level differences only ("postal code", "unit"), never the whole
  /// payload, so a reviewer sees what would actually change.
  differences       Json?
  /// Google's own granularity and the field-level confirmations, reduced to the
  /// small set the interface needs.
  granularity       String?
  placeId           String?
  /// Why the check could not be completed, when it could not.
  unavailableReason String?
  /// Who accepted an unresolved address, and why. Required for OVERRIDDEN.
  overriddenById    String?
  overriddenByName  String?
  overrideReason    String?
  checkedAt         DateTime       @default(now())
  /// When this verdict stops being usable for booking. Null means it does not
  /// age out on its own — an edit is what invalidates it.
  expiresAt         DateTime?
  createdAt         DateTime       @default(now())

  @@index([subjectType, subjectId])
  @@index([inputHash])
}

/// Which images an import into a seller's store is allowed to bring across.
///
/// WHY THE CHOICE IS PERSISTED. Two separate requirements need the decision to
/// outlive the import that made it. The first is that a later sync must not
/// silently add back an image the seller excluded — a selection held only in a
/// form is re-asked next time, and the default answer to "which images?" is
/// "all of them", so the exclusion would quietly reverse itself. The second is
/// that a retry must not duplicate what an earlier attempt already uploaded,
/// which needs the previous attempt's choices to still exist.
///
/// KEYED ON THE MOONVELLA SIDE, DELIBERATELY. `productId` and `mediaAssetId`
/// are MoonVella ids, not the seller's: the selection has to be matchable
/// before anything has been uploaded anywhere, and it has to survive the
/// seller renaming or reordering images in their own store. The unique
/// constraint is what makes a retry idempotent — re-saving the same choice
/// updates one row rather than creating a second.
model ImportMediaSelection {
  id           String  @id @default(cuid())
  sellerId     String
  productId    String
  mediaAssetId String
  selected     Boolean @default(false)
  /// The chosen main image. At most one per (seller, product): the service
  /// clears the previous one in the same transaction, because a partial unique
  /// index on a boolean is a constraint Prisma cannot express.
  isMain       Boolean @default(false)
  sortOrder    Int     @default(0)

  // --- upload outcome, so a retry is a retry and not a duplicate -----------
  /// PENDING, UPLOADED, FAILED or SKIPPED. A row that already reached
  /// UPLOADED is never sent again: the seller's store is not ours to write
  /// twice, and a second identical image is visible to shoppers.
  uploadStatus    String    @default("PENDING")
  /// The store's own id for the uploaded image, kept so a later sync can
  /// recognise its own earlier work rather than matching on a URL or a
  /// filename, both of which the seller may change.
  providerMediaId String?
  uploadAttempts  Int       @default(0)
  /// The last failure, in the provider's own words, so the operator can see
  /// what to fix. Never a credential — provider messages are redacted before
  /// they are written.
  lastUploadError String?
  uploadedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, productId, mediaAssetId])
  @@index([sellerId, productId])
}

/// One operator's answer to a question about the whole admin, stored by name.
///
/// WHY A TABLE AND NOT A COLUMN SOMEWHERE. There is no row that means "the
/// admin": MoonVella's settings are per-seller (SellerSettings), per-integration
/// (IntegrationCredential) or per-record, and none of those can hold a choice
/// that belongs to the operator rather than to a store. A key/value row says
/// what it is — one preference, named — and adding the next one does not widen
/// a table that something else is already reading.
///
/// Absence is meaningful and is the reason `getUnitsPreference` reads a missing
/// row as the default rather than treating it as an error: a fresh deployment
/// has expressed no preference, and the default is the answer, not a gap.
model AdminPreference {
  id        String   @id @default(cuid())
  /// The question, not the answer: "units".
  key       String   @unique
  /// The answer, as one of the values the reading service accepts. Stored as
  /// text so a new preference does not need a migration to add a column; the
  /// service validates it on the way in and falls back on the way out.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
