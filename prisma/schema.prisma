// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Production runs on PostgreSQL. The SQLite datasource this replaced could not
// be carried forward: its migrations are SQLite-flavoured SQL that PostgreSQL
// rejects, so a fresh baseline was generated instead (see
// prisma/migrations-sqlite-legacy/ for the retired history, kept for reference
// only and never applied).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// An administrative identity for the owner panel.
///
/// This was called OwnerUser while the panel had exactly one account. It now
/// holds every staff member, and an OPERATIONS or VIEWER user is not an owner,
/// so the name follows the job. The rename cost nothing at the moment it was
/// made: the table held zero rows.
model AdminUser {
  id           String    @id @default(cuid())
  /// Always stored trimmed and lower-cased, and sign-in normalises the same
  /// way, so "A@B.com" and "a@b.com" can never become two accounts.
  email        String    @unique
  name         String
  /// Null until an invitation is accepted. A pending invitee therefore holds no
  /// credential at all, rather than a placeholder that could be guessed.
  passwordHash String?
  role         AdminRole @default(VIEWER)
  isActive     Boolean   @default(true)

  /// The primary owner. At most one row may carry this flag: the migration
  /// creates a partial unique index on it, so the invariant is enforced by the
  /// database and not only by the application code that happens to respect it.
  isPrimaryOwner Boolean @default(false)

  /// Set when the invited person proves control of the address by accepting.
  /// Distinguishes a proven address from one an operator merely typed in.
  emailVerifiedAt    DateTime?
  /// Forces a password change at next sign-in. Used for recovery, not by the
  /// ordinary invitation flow.
  mustChangePassword Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  /// Durable per-account failure tally, surfaced in the user list. LoginAttempt
  /// remains the source of truth for throttling; this is the visible counter.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  /// Who created the account. Null for the primary owner, who is created by the
  /// CLI and has no creator.
  createdById  String?
  createdBy    AdminUser?  @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers AdminUser[] @relation("CreatedUsers")

  sessions             AdminSession[]
  invitationsSent      AdminInvitation[]     @relation("InvitedBy")
  reviewedApplications MerchantApplication[] @relation("ReviewedApplications")

  @@index([isActive])
  @@index([role])
}

/// A signed-in session.
///
/// The token itself is NOT stored — only its SHA-256 digest. A copy of this
/// table (a backup, a replica, a query that reads one row) therefore yields no
/// usable credential, because the digest cannot be replayed as a cookie. The
/// raw token exists only in the client's cookie and in the request that set it.
///
/// SHA-256 is the right choice here rather than bcrypt: the token is 256 bits
/// of CSPRNG output, not a human-chosen password, so there is no dictionary to
/// attack and no work factor worth adding. The hash is verified on every
/// authenticated request, where a slow KDF would be a self-inflicted denial of
/// service.
model AdminSession {
  id           String    @id @default(cuid())
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token, hex-encoded. Never the token itself.
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastAccessAt DateTime  @default(now())
  /// Captured at sign-in, for the session list and audit correlation.
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@index([expiresAt])
}

enum AdminRole {
  OWNER
  ADMIN
  OPERATIONS
  CATALOG
  SUPPORT
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// An invitation to create a staff account.
///
/// Only the SHA-256 digest of the token is stored, for the same reason as
/// AdminSession: the digest cannot be turned back into a working link. The
/// token appears exactly once, in the URL handed to the invited person, and is
/// unrecoverable from this table afterwards — which is why the owner is offered
/// a one-time copy of the link rather than a "resend existing link" button.
model AdminInvitation {
  id          String           @id @default(cuid())
  /// Normalised exactly as AdminUser.email is.
  email       String
  name        String
  /// The role this invitation grants. Held here and never read from the
  /// acceptance request, so an invitee cannot turn a CATALOG invitation into an
  /// OWNER account by editing the form they submit.
  role        AdminRole
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  /// 24 hours from creation, checked on redemption and not only on display.
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  cancelledAt DateTime?

  invitedById String
  invitedBy   AdminUser @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status, expiresAt])
}

model MerchantApplication {
  id                String  @id @default(cuid())
  shopDomain        String  @unique
  storeName         String
  shopifyPlan       String?
  storeUrl          String?
  country           String?
  currency          String?
  /// The merchant's own answers, given on submission. Nullable because a row
  /// exists before anything is answered: opening the application page caches the
  /// imported Shopify profile onto a row, which is what gives the page a stored
  /// snapshot, a "last refreshed" time, and a Refresh button that means
  /// something. Such a row is a DRAFT — imported facts and no answers — and
  /// `submittedAt` is what says which of the two a row is.
  ///
  /// NULL is the only honest way to store "not answered yet". A blank string is
  /// a value that looks like an answer: it would reach the review queue, and the
  /// seller record an approval writes, as though the merchant had said it. This
  /// is the same substitution the pricing rules refuse, in the same shape.
  contactName       String?
  email             String?
  phone             String?
  urgentPhone       String?
  /// The emergency contact's own name. The application asks whether the urgent
  /// number belongs to the person above or to somebody else, and a number
  /// without a name is not an answer to "who do we call".
  urgentContactName String?
  /// Nullable for the same reason as `contactName` above: it is the merchant's
  /// answer, and a draft row has none. It is never derived from the store name —
  /// a legal name is a fact about a business, not a rendering of its shop.
  legalBusinessName String?
  /// DEPRECATED, and no longer written or rendered. It was one free-text box
  /// standing in for an address, which cannot be mapped onto Odoo's street /
  /// street2 / city / zip / state / country fields without guessing where one
  /// ends and the next begins. The structured columns below replaced it. Kept
  /// as a nullable column so values already stored are not destroyed.
  sellerAddress     String?
  gstHstNumber      String?

  // --- imported from Shopify -------------------------------------------
  // Everything below is filled from the authenticated Admin API session, never
  // from a submitted browser field. The shop identity is taken from the
  // session's shop domain, so a form cannot claim to be another store.
  /// The permanent Shopify shop id (`gid://shopify/Shop/…`). It survives a
  /// domain change, which the myshopify domain does not.
  shopifyShopId       String?
  /// `shop.email` — the account owner's address.
  storeOwnerEmail     String?
  /// `shop.contactEmail` — the address the storefront publishes. Stored
  /// separately from the owner's: they are different people on most stores,
  /// and one mailbox cannot be both.
  storeContactEmail   String?
  addressLine1        String?
  addressLine2        String?
  addressCity         String?
  addressProvinceCode String?
  addressPostalCode   String?
  addressCountryCode  String?
  /// Which fields the import actually produced a value for, which it found
  /// empty in Shopify, and which a merchant has since edited. Without this a
  /// blank box cannot say whether Shopify had nothing or nobody ever looked.
  profileFieldSources Json?             @default("{}")
  /// The last raw response, kept so the page can show why a field is missing
  /// rather than showing an empty input and an apology.
  shopifyProfileJson  Json?             @default("{}")
  profileRefreshedAt  DateTime?
  profileRefreshError String?
  /// The merchant's answer, and nullable for the same reason as `contactName`
  /// above: a draft row has none. The submission form supplies "Other" when the
  /// merchant picks nothing from the list, which is what makes the difference
  /// between "they answered Other" and "they have not answered".
  productCategory     String?
  markets             String            @default("[]")
  status              ApplicationStatus @default(PENDING)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  reviewedBy          AdminUser?        @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  rejectionReason     String?
  internalNotes       String?
  businessStartDate   DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shopifyStoreProfile String?           @default("{}")
  shopifySalesReview  String?           @default("{}")
  merchantContact     String?           @default("{}")
  seller              Seller?

  @@index([status])
  @@index([shopDomain])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
  /// Deliberately distinct from SUSPENDED. A deactivation revokes approved
  /// access but invites the merchant to apply again; the application is shown
  /// prefilled and a resubmission returns it to PENDING for a fresh owner
  /// decision. A suspension is an owner action that the merchant is not asked
  /// to resolve. Collapsing the two would make one control lie about itself.
  DEACTIVATED
  BLOCKED
}

model Seller {
  id                 String                   @id @default(cuid())
  shopDomain         String                   @unique
  storeName          String
  shopDomainFull     String
  contactEmail       String
  contactName        String?
  phone              String?
  country            String?
  currency           String                   @default("CAD")
  shopifyPlan        String?
  storeUrl           String?
  applicationId      String?                  @unique
  application        MerchantApplication?     @relation(fields: [applicationId], references: [id])
  status             SellerStatus             @default(PENDING)
  approvedAt         DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?
  // Blocked is a separate state from suspended, so it gets its own columns: a
  // suspension reason that actually holds a block reason is a record that lies
  // about which control was used.
  blockedAt          DateTime?
  blockReason        String?
  /// Deactivation is a third control, so it gets a third pair of columns for
  /// the same reason block did: a suspension reason column holding a
  /// deactivation reason is a record that lies about which control was used.
  deactivatedAt      DateTime?
  deactivationReason String?
  /// Bumped on every access-changing write. Deferred work carries the version
  /// it was queued under and is cancelled if it no longer matches, so a job
  /// created while a seller was approved cannot run after they were blocked.
  accessVersion      Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  installedAt        DateTime?
  domainRegisteredAt DateTime?
  businessStartDate  DateTime?
  lastSyncAt         DateTime?
  syncStatus         SyncStatus               @default(NEVER)
  products           SellerProduct[]
  orders             Order[]
  wholesalePayments  WholesalePayment[]
  billingSettings    SellerBillingSettings?
  paymentMethods     SellerPaymentMethod[]
  bankAccounts       SellerBankAccount[]
  settings           SellerSettings?
  brandKit           SellerBrandKit?
  contactMappings    ExternalContactMapping[]
  jobs               BackgroundJob[]

  @@index([status])
  @@index([shopDomain])
}

enum SellerStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
  /// Revoked-but-reapplicable. See ApplicationStatus.DEACTIVATED.
  DEACTIVATED
  BLOCKED
  UNINSTALLED
}

/**
 * The three Odoo records one approved seller maps onto. Each is a separate
 * partner row with its own durable mapping, because a single "contact" record
 * cannot carry a company's legal name and an individual's mobile at once
 * without one of them being wrong.
 */
enum ContactRole {
  COMPANY
  CONTACT
  URGENT_CONTACT
}

enum ContactSyncStatus {
  /// Queued or being attempted. Not a failure: Odoo may simply be unreachable.
  PENDING
  SYNCED
  FAILED
  /// Deliberately not synced (e.g. no emergency contact was supplied).
  NOT_REQUIRED
}

/**
 * How far a product has got towards being archived in the seller's Shopify
 * store. Archiving is a separate axis from the import status: a product can be
 * fully IMPORTED and still PENDING archive, and that is exactly the state a
 * just-blocked seller's catalog is in.
 */
enum ProductArchiveStatus {
  NOT_APPLICABLE
  PENDING
  ARCHIVED
  FAILED
}

/**
 * A unit of deferred work.
 * MoonVella had no queue at all before this: every action was synchronous, so a
 * slow or unreachable third party made the owner's click fail. Approval must
 * survive Odoo being down and blocking must survive Shopify being slow, so the
 * work is recorded here and drained by a runner that can be retried.
 */
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Abandoned because the world moved on — a seller's access changed, or the
  /// owner blocked and then unblocked. Never a silent no-op: the reason is
  /// written to lastError.
  CANCELLED
}

enum SyncStatus {
  NEVER
  SYNCING
  SUCCESS
  FAILED
}

model SellerSettings {
  id                   String   @id @default(cuid())
  sellerId             String   @unique
  seller               Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  autoSyncInventory    Boolean  @default(true)
  quantityBuffer       Int      @default(5)
  lowStockAlerts       Boolean  @default(true)
  autoImportOrders     Boolean  @default(true)
  estimatedDeliveryMsg String   @default("Typically ships within 2–4 business days.")
  defaultMarkup        Int      @default(200)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A product family. It is a description, not a thing that exists in a
/// warehouse, and it is never the subject of an order line, an inventory count
/// or a storefront listing.
///
/// The flat model this replaced carried `sku`, `wholesalePrice`,
/// `suggestedRetailPrice` and `costPrice` on the product itself, which meant a
/// family with three sizes could express only one price and one stock level.
/// Those columns are gone: `sku` became the required and unique `productCode`
/// below, and the three money columns moved down to ProductVariant, where the
/// sellable unit lives. The migration copied every existing value into a
/// generated Default variant before dropping them, so nothing was lost.
///
/// `images` (a JSON array of URLs) and the ProductImage table were retired the
/// same way: both were a flat, per-product media list that could not express a
/// variant-specific image or a file shared between variants. Their URLs were
/// converted into MediaAsset rows with a shared assignment. See MediaAsset for
/// the model that replaced them.
model Product {
  id               String           @id @default(cuid())
  name             String
  description      String?
  category         String
  currency         String           @default("CAD")
  categoryId       String?
  categoryRef      Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  sellerProducts   SellerProduct[]
  /// Where this product ships from, by default. A variant may override it.
  ///
  /// A REFERENCE, not a copy of the address. The address itself lives once, on
  /// PickupLocation, because the same dock is shared by many products and an
  /// address typed onto each of them cannot be corrected in one place — the
  /// failure that produces is a parcel collected from a door nobody updated.
  /// Null is meaningful and is never filled in from a "global" default: an
  /// unmapped product cannot be quoted or booked, and says so by name.
  pickupLocationId String?
  pickupLocation   PickupLocation?  @relation("ProductPickupLocation", fields: [pickupLocationId], references: [id])
  /// Packaging defaults for this product. A variant with its own rows overrides
  /// them; a variant without inherits these.
  packages         ProductPackage[]
  orderItems       OrderItem[]      @relation("OrderItemProduct")
  isActive         Boolean          @default(true)
  isPublished      Boolean          @default(true)
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// The family code. Required, unique, trimmed and upper-cased, and validated
  /// against a documented character set by app/utils/productCode.ts.
  ///
  /// Whitespace is rejected rather than stripped. Collapsing it silently would
  /// let two distinct codes become one row with no explanation shown to the
  /// person who typed it.
  ///
  /// It is deliberately NOT a variant SKU and must never be exported as one:
  /// it identifies the family, while each sellable unit has its own SKU on
  /// ProductVariant. A future Shopify import maps it to a product metafield.
  productCode      String  @unique
  /// Bulleted feature list, one per line. Stored as written; the interface
  /// renders it as a list.
  features         String?
  /// Materials and composition.
  materials        String?
  /// General care instructions for the family. A variant may add its own in a
  /// care-guide document.
  careInstructions String?

  /// The editorial state. The merchant-facing flags above are kept consistent
  /// with this by the publication gate, which is the only thing that sets
  /// either to published.
  status ProductStatus @default(DRAFT)

  /// Who created and last changed the record. Nullable because rows migrated
  /// from the flat model have no known author, and inventing one would be worse
  /// than admitting the gap.
  createdById String?
  updatedById String?

  mediaAssets      MediaAsset[]
  externalMappings ExternalProductMapping[]

  @@index([category])
  @@index([isActive])
  @@index([status])
}

// ProductImage was removed here. It was a flat list of {url, alt} rows hanging
// off the product, with no way to say "this image is for the King variant" or
// "this image is shared by all of them", and no notion of processing state,
// approval or seller visibility. Its rows were converted to MediaAsset rows
// with a shared assignment by the product/variant/media migration. The
// replacement is MediaAsset + MediaAssetAssignment.

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProductVariant {
  id                    String                 @id @default(cuid())
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String                 @unique
  name                  String
  wholesalePrice        Int
  suggestedRetailPrice  Int
  costPrice             Int?
  inventory             Int                    @default(0)
  reserved              Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  variantImageUrl       String?
  shipsSeparately       Boolean                @default(false)
  packingInstructions   String?
  shippingDescription   String?
  declaredValueDefault  Int?
  /// Free-text dimensions from the flat model ("60x40x15"), retained verbatim
  /// rather than parsed. The migration moved `weight` into the canonical
  /// productWeightKg below, but a free-text string cannot be split into three
  /// trustworthy numbers — guessing "60x40x15" is cm and not inches would be
  /// inventing data. Kept so the value survives; the typed columns are what
  /// anything new reads.
  legacyDimensions      String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  orderItems            OrderItem[]            @relation("OrderItemVariant")
  sellerProductVariants SellerProductVariant[]
  packages              VariantPackage[]

  /// Optional barcode/UPC. Unique when present — a barcode identifies exactly
  /// one sellable unit — but nullable, because most variants will not have one
  /// and PostgreSQL permits many NULLs in a unique index.
  barcode String? @unique

  /// Display order within the product. Also the order the seller's storefront
  /// sees, so it is meaningful rather than cosmetic.
  sortOrder Int @default(0)

  /// The variant a single-variant product is sold as. Every product has exactly
  /// one of these after migration; see the Default-variant rule in the
  /// product/variant migration. It is a hint for the interface, not a
  /// constraint on how many variants may exist.
  isDefault Boolean @default(false)

  currency String @default("CAD")

  /// When false the variant is not stock-tracked and `inventory` is advisory.
  trackInventory       Boolean @default(true)
  /// Placeholder for a future external inventory system. Never populated with
  /// a credential.
  externalInventoryRef String?

  /// How many sellable units are in one package. Distinct from
  /// VariantPackage.unitsPerPackage, which describes a shipping carton.
  unitsPerPackage Int @default(1)

  // --- unpacked product measurements -------------------------------------
  // Canonical units are centimetres and kilograms, stored as exact decimals.
  // The interface may display inches and pounds, but conversion is a display
  // concern: these columns are what every calculation, snapshot and export
  // reads, so a converted value can never quietly become the stored one.
  productLengthCm Decimal? @db.Decimal(10, 2)
  productWidthCm  Decimal? @db.Decimal(10, 2)
  productHeightCm Decimal? @db.Decimal(10, 2)
  productWeightKg Decimal? @db.Decimal(10, 3)

  /// Overrides the product's pickup location for this variant alone, for the
  /// case where one size is stocked at a different dock. Null means "inherit
  /// the product's" and is not the same as "no location": the resolver walks
  /// variant → product and reports a missing mapping only when BOTH are null.
  pickupLocationId String?
  pickupLocation   PickupLocation? @relation("VariantPickupLocation", fields: [pickupLocationId], references: [id])

  variantOptions   VariantOption[]
  mediaAssignments MediaAssetAssignment[]
  externalMappings ExternalVariantMapping[]
  stockRecords     VariantStockRecord[]

  @@index([productId, sortOrder])
}

/// One stock record behind a variant's on-hand figure: how much of it sits at
/// one Odoo location, and whose it is.
///
/// WHY THIS IS A TABLE AND NOT A NUMBER. A variant's `inventory` is a total, and
/// a total on its own cannot answer the two questions that come next: where the
/// goods are, and who owns them. The catalogue now counts every shelf inside the
/// fulfillment warehouse, which means one figure can be two vendors' stock and
/// the company's own — so the parts are kept, not just the sum. Ownership here
/// is about the goods on the shelf (Odoo's `stock.quant.owner_id`), which is a
/// different fact from the product's supplier: the supplier is who MoonVella
/// buys from, the owner is whose boxes these are.
///
/// The rows are REPLACED on every sync, never appended to, so a sync that runs
/// every six hours cannot accumulate history that reads like current stock.
/// `odooOwnerId` is null for company-owned stock — Odoo writes `false` there,
/// and "the company owns it" is a real answer that must not be confused with
/// "nobody knows".
model VariantStockRecord {
  id       String         @id @default(cuid())
  variantId String
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// The Odoo location this stock sits at, and its name as Odoo shows it
  /// ("WH/Stock/EcoComfort Consignment"), kept because a location can be
  /// renamed or archived in Odoo and the record should still read as it did.
  odooLocationId Int
  locationName   String

  /// The Odoo partner that owns the goods, null when the company does.
  odooOwnerId Int?
  ownerName   String?

  quantity         Int
  reservedQuantity Int

  /// Which Odoo database these ids belong to. MoonVella can be pointed at more
  /// than one, and an id without its database is not an identifier.
  odooDatabase String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per location and owner. PostgreSQL treats NULLs as distinct, so
  /// this binds the owned rows and leaves company-owned ones to the replace
  /// -never-append rule that writes them.
  @@unique([variantId, odooLocationId, odooOwnerId])
  @@index([variantId])
}

model PackagingPreset {
  id              String           @id @default(cuid())
  name            String           @unique
  packageType     String           @default("carton")
  length          Float
  width           Float
  height          Float
  dimensionUnit   String           @default("cm")
  emptyWeight     Float?
  weightUnit      String           @default("kg")
  maxWeight       Float?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  packages        VariantPackage[]
  productPackages ProductPackage[]
}

model VariantPackage {
  id              String           @id @default(cuid())
  variantId       String
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  label           String?
  packageType     String           @default("carton")
  presetId        String?
  preset          PackagingPreset? @relation(fields: [presetId], references: [id])
  length          Float
  width           Float
  height          Float
  dimensionUnit   String           @default("cm")
  grossWeight     Float
  weightUnit      String           @default("kg")
  unitsPerPackage Int              @default(1)
  packagesPerUnit Int              @default(1)
  sortOrder       Int              @default(0)
  /// What the box is, in the packer's words ("double-wall carton, foam corners").
  description     String?
  /// Insurance basis for this parcel when the carrier offers declared value.
  /// Cents, like every other money column here. Null means "not declared",
  /// which is different from zero and is never sent as 0.
  declaredValue   Int?
  /// A parcel that must travel on its own — a crate, a pallet, anything the
  /// packer may not combine with another parcel. Distinct from
  /// ProductVariant.shipsSeparately, which is about the ITEM; this is about the
  /// BOX, and one item can ship as two boxes where only one is indivisible.
  ///
  /// DEFAULTS TO TRUE: a new box travels on its own until somebody says
  /// otherwise. The opposite default meant every carton added silently claimed
  /// it could be merged with any other.
  shipsSeparately Boolean          @default(true)
  /// Whether this parcel may be merged into another parcel of the same ship
  /// group during packing. Advisory to the packer; it never merges on its own.
  ///
  /// DEFAULTS TO FALSE, and it can never be true while `shipsSeparately` is:
  /// the two are contradictory, the application refuses the pair on every
  /// write, and a CHECK constraint in the database refuses it too. A box is
  /// merged only when somebody has decided it may be.
  consolidatable  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([variantId])
}

/// Packaging defaults for a PRODUCT, inherited by its variants.
///
/// WHY A SECOND TABLE. The directive is explicit that a variant inherits its
/// product's packaging unless it overrides it, and shows the reader which of
/// the two a value came from. One table cannot express that: rows attached to
/// the variant alone leave "did this come from the product, or was it typed
/// here?" unanswerable, and the answer decides what a later edit to the product
/// does to this variant. Two tables make inheritance a fact about which rows
/// exist rather than a flag somebody has to keep true.
///
/// The columns are deliberately identical to VariantPackage's, and the resolver
/// returns one shape for both, so nothing downstream needs to know which table
/// a parcel came from.
model ProductPackage {
  id              String           @id @default(cuid())
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String?
  packageType     String           @default("carton")
  presetId        String?
  preset          PackagingPreset? @relation(fields: [presetId], references: [id])
  length          Float
  width           Float
  height          Float
  dimensionUnit   String           @default("cm")
  grossWeight     Float
  weightUnit      String           @default("kg")
  unitsPerPackage Int              @default(1)
  packagesPerUnit Int              @default(1)
  sortOrder       Int              @default(0)
  description     String?
  declaredValue   Int?
  /// See VariantPackage: new boxes travel on their own, and never claim a
  /// permission to be merged at the same time.
  shipsSeparately Boolean          @default(true)
  consolidatable  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([productId])
}

model SellerProduct {
  id                   String                 @id @default(cuid())
  sellerId             String
  seller               Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId            String
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyProductId     String?
  shopifyVariantIds    String                 @default("[]")
  importedAt           DateTime?
  importStatus         SyncStatus             @default(NEVER)
  lastImportError      String?
  isActive             Boolean                @default(true)
  customWholesalePrice Int?
  customRetailPrice    Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  orderItems           OrderItem[]            @relation("OrderItemSellerProduct")
  variantMappings      SellerProductVariant[]

  @@unique([sellerId, productId])
  @@index([sellerId])
  @@index([productId])
}

model SellerProductVariant {
  id                     String         @id @default(cuid())
  sellerProductId        String
  sellerProduct          SellerProduct  @relation(fields: [sellerProductId], references: [id], onDelete: Cascade)
  productVariantId       String
  productVariant         ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  shopifyProductId       String
  shopifyVariantId       String
  shopifyInventoryItemId String?
  shopifyLocationId      String?
  syncStatus             SyncStatus     @default(NEVER)
  syncedAt               DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([sellerProductId, productVariantId])
  @@unique([shopifyVariantId])
  @@index([sellerProductId])
}

model Order {
  id                        String                 @id @default(cuid())
  sellerId                  String
  seller                    Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopifyOrderId            String
  shopifyOrderName          String
  shopifyOrderNumber        Int
  customerEmail             String?
  customerName              String?
  customerPhone             String?
  shippingAddress           String?
  billingAddress            String?
  currency                  String                 @default("CAD")
  subtotal                  Int
  totalTax                  Int
  totalShipping             Int
  totalDiscounts            Int
  totalPrice                Int
  moonvellaSubtotal         Int
  moonvellaTax              Int
  moonvellaShipping         Int
  moonvellaDiscounts        Int
  moonvellaTotal            Int
  paymentStatus             PaymentStatus          @default(PENDING)
  fulfillmentStatus         FulfillmentStatus      @default(PENDING)
  financialStatus           String?
  shopifyCreatedAt          DateTime
  shopifyUpdatedAt          DateTime
  processedAt               DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  supplierReference         String?                @unique
  shopifyFulfillmentOrderId String?
  wholesalePaymentStatus    WholesalePaymentStatus @default(REQUIRES_PAYMENT)
  items                     OrderItem[]
  refunds                   Refund[]
  shipments                 Shipment[]
  wholesalePayment          WholesalePayment?
  fulfillmentRequest        FulfillmentRequest?
  shippingQuotes            ShippingQuote[]
  packages                  OrderPackage[]
  /// When the order's quotes stopped describing it, and why.
  ///
  /// A quote prices the parcels that existed when it was asked for. Change the
  /// packaging, the address or the date and every quote on the order is a price
  /// for something else — so they are removed and this records what removed
  /// them. The booking gate reads the surviving quotes, which means a superseded
  /// quote cannot be booked by remembering its id.
  quotesInvalidatedAt       DateTime?
  quoteInvalidationReason   String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([shopifyCreatedAt])
  @@index([processedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIAL
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?        @relation("OrderItemProduct", fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation("OrderItemVariant", fields: [variantId], references: [id])
  sellerProductId    String?
  sellerProduct      SellerProduct?  @relation("OrderItemSellerProduct", fields: [sellerProductId], references: [id])
  shopifyLineItemId  String
  name               String
  sku                String
  quantity           Int
  price              Int
  wholesalePrice     Int
  totalDiscount      Int
  isMoonvellaProduct Boolean         @default(true)
  createdAt          DateTime        @default(now())
  refundItems        RefundItem[]
  shipmentItems      ShipmentItem[]

  // --- variant snapshot ---------------------------------------------------
  //
  // Everything below is a copy taken when the order was placed, not a live
  // read. An order must keep showing what was actually sold even after the
  // product is renamed, repriced, re-measured or archived, so nothing here is
  // ever recalculated from the current catalogue. All of it is nullable
  // because orders placed before variants existed have no variant to snapshot,
  // and a legacy row must stay readable rather than be back-filled with values
  // that would look like they were observed at the time.
  //
  // `name`, `sku`, `price` and `wholesalePrice` above are the original snapshot
  // columns and keep their meaning: product name, the SKU charged, the price
  // charged and the wholesale price charged.
  productCode       String?
  variantName       String?
  /// The ordered option pairs as they stood at purchase, JSON-encoded. A string
  /// rather than a relation for the same reason as the rest: the variant's
  /// options may be renamed or deleted afterwards.
  selectedOptions   String?
  /// The seller's own list price for this variant at the time, recorded only
  /// when it differed from what was actually charged. `price` remains what the
  /// customer paid; this is the intended figure, kept so a discounted line can
  /// still explain itself. `wholesalePrice` is what MoonVella charged the
  /// seller, which is a different party and a different number.
  sellerRetailPrice Int?
  currency          String?

  /// Measurements as snapshotted, canonical cm/kg, same reasoning as above.
  productLengthCm Decimal? @db.Decimal(10, 2)
  productWidthCm  Decimal? @db.Decimal(10, 2)
  productHeightCm Decimal? @db.Decimal(10, 2)
  productWeightKg Decimal? @db.Decimal(10, 3)

  /// The shipping carton actually used, resolved from the variant's first
  /// package at order time.
  packageLengthCm  Decimal? @db.Decimal(10, 2)
  packageWidthCm   Decimal? @db.Decimal(10, 2)
  packageHeightCm  Decimal? @db.Decimal(10, 2)
  packagedWeightKg Decimal? @db.Decimal(10, 3)
  unitsPerPackage  Int?
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId String
  amount          Int
  reason          String?
  processedAt     DateTime
  items           RefundItem[]
  createdAt       DateTime     @default(now())
}

model RefundItem {
  id          String    @id @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  amount      Int
  reason      String?
  createdAt   DateTime  @default(now())
}

model Shipment {
  id                      String                  @id @default(cuid())
  orderId                 String
  order                   Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyFulfillmentId    String?
  trackingNumber          String?
  trackingUrl             String?
  carrier                 String?
  serviceName             String?
  serviceCode             String?
  provider                String?
  providerShipmentId      String?
  /// The provider quote id used to book, when the provider issues one. Held so a
  /// reprint or a reconciliation reads the same quote rather than re-quoting.
  providerQuoteId         String?
  labelUrl                String?
  labelDocumentFormat     String?
  /// The seller's fixed shipping charge allocated to THIS shipment. A split
  /// shipment carries only its own allocation; the order total is never repeated
  /// per parcel. Null when no allocation rule is configured.
  sellerShippingCharge    Int?
  /// The carrier cost quoted when the shipment was booked.
  quotedCarrierCost       Int?
  /// The carrier cost actually booked. Kept separate from the quote because a
  /// provider may book at a different amount than it quoted.
  bookedCost              Int?
  /// The final amount the carrier billed, once a supplier invoice is known.
  finalBilledCost         Int?
  /// Reconciliation state of the carrier cost: PENDING, RECONCILED, VARIANCE or
  /// NEEDS_RECONCILIATION. Never used to change the seller's agreed charge.
  billingStatus           String                  @default("PENDING")
  /// eShipper's invoice number for the supplier bill this shipment belongs to.
  providerInvoiceNumber   String?
  billingInvoices         String?
  /// Normalized tracking state for the interface, distinct from the coarse
  /// ShipmentStatus so "label created" is never reported as "shipped".
  trackingStatus          String?
  /// When the provider was last asked to book, and what it last said.
  ///
  /// `lastBookingError` holds the provider's own refusal, redacted, so an
  /// operator reading a failed booking sees the reason rather than a status
  /// code. It is cleared on a successful booking and never overwritten by a
  /// timeout — a timeout is recorded as BOOKING_UNKNOWN with its own timestamp,
  /// because "the provider said no" and "the provider said nothing" lead to
  /// different next actions.
  bookingAttemptedAt      DateTime?
  bookingOutcomeUnknownAt DateTime?
  lastBookingError        String?
  /// The pickup, if one was arranged for this shipment. A booked shipment does
  /// NOT imply a scheduled pickup: the label is bought from the carrier and the
  /// collection is booked separately, and conflating them is how a parcel sits
  /// on a dock waiting for a truck nobody called.
  ///
  /// Values: NONE | SCHEDULED | CANCELLED | FAILED | MISSED | UNKNOWN.
  pickupStatus            String?
  /// How this parcel is meant to leave the dock: NEEDED (call a truck), REGULAR
  /// (the dock already has a standing collection), DROPOFF (the carrier's depot
  /// takes it). Defaulted from the origin when the shipment is booked, then held
  /// here because the dock's arrangement can change afterwards and a parcel
  /// already prepared must keep the answer it was prepared under.
  ///
  /// A booked shipment is not a collected one. This column says what was
  /// ARRANGED; `pickupStatus` says what the provider confirmed.
  pickupMode              String?
  providerPickupId        String?
  pickupScheduledFor      DateTime?
  /// The collection window as the provider confirmed it. Kept as text because
  /// carriers return windows in their own words ("09:00-17:00", "before noon"),
  /// and normalizing that into a timestamp pair would invent precision the
  /// carrier did not offer.
  pickupWindow            String?
  pickupConfirmation      String?
  pickupLastError         String?
  /// When a cancellation was CONFIRMED, and only then: set while pickupStatus is
  /// CANCELLED and cleared the moment it is not. A pickup that the provider says
  /// still stands, or one whose cancellation nobody answered, keeps no
  /// timestamp — a column that records a confirmation must not outlive the state
  /// it confirms, or the record contradicts itself and the wrong half is
  /// believed. History lives in the audit log.
  pickupCancelledAt       DateTime?
  estimatedDelivery       DateTime?
  lastTrackingSyncAt      DateTime?
  /// When the carrier was last ASKED, whether or not it answered. The backoff
  /// between attempts is computed from trackingSyncFailures but has to be
  /// measured from somewhere, and lastTrackingSyncAt cannot be that place: only
  /// a successful poll writes it, so a shipment whose very first poll failed
  /// had no timestamp and was re-polled every sweep. Falls back to
  /// lastTrackingSyncAt for rows written before this column existed.
  lastTrackingAttemptAt   DateTime?
  lastTrackingError       String?
  /// Consecutive failed tracking polls. Drives the backoff between attempts and
  /// is reset the moment a poll succeeds, so "this shipment has been unreachable
  /// four times" is a fact on the row rather than a calculation over a log. A
  /// failed poll never clears the last good status — see syncTrackingForShipment.
  trackingSyncFailures    Int                     @default(0)
  /// When a tracking sweep last CLAIMED this row to poll it. The claim is what
  /// stops two sweeps polling the same parcel at once, and it is cleared when
  /// the poll finishes, either way. A row still claimed after the lease has
  /// expired belonged to a sweep that died, and is treated as free again.
  ///
  /// Deliberately NOT lastTrackingSyncAt: that column means "the carrier last
  /// answered", and a claim is not an answer. Overloading it would make a
  /// crashed sweep look like a successful refresh.
  trackingPollClaimedAt   DateTime?
  /// When the customer was last told, through Shopify, that this parcel is on
  /// its way. Recorded so a retry, a second push or a re-run of the sweep cannot
  /// notify twice: Shopify sends the e-mail on the call, and a duplicate
  /// notification is not something an operator can undo.
  shopifyNotifiedAt       DateTime?
  /// The Shopify fulfillment this shipment created, when the push succeeded, and
  /// when it last succeeded. Recorded on the shipment so a retry can ask "have I
  /// already done this" without asking Shopify, which answers "already
  /// fulfilled" by erroring rather than by being idempotent.
  shopifySyncedAt         DateTime?
  /// Why the last push to Shopify did not go through, in Shopify's own words.
  /// Cleared on success. Kept per shipment rather than only on the integration
  /// row, because "this one parcel did not reach Shopify" is a fact about the
  /// parcel and an operator needs it on the parcel's page.
  shopifySyncError        String?
  /// A return shipment points at the original shipment it returns.
  returnOfShipmentId      String?
  returnReason            String?
  bookingIdempotencyKey   String?                 @unique
  packageCount            Int?
  status                  ShipmentStatus          @default(PENDING)
  labelCreatedAt          DateTime?
  packedAt                DateTime?
  handedToCarrierAt       DateTime?
  shippedAt               DateTime?
  inTransitAt             DateTime?
  deliveredAt             DateTime?
  exceptionAt             DateTime?
  cancelledAt             DateTime?
  /// The origin this shipment collects from. A single order whose items come
  /// from two origins becomes two shipments, and this is what tells them apart.
  originLocationId        String?
  originLocation          PickupLocation?         @relation(fields: [originLocationId], references: [id], onDelete: SetNull)
  /// The origin address and contact AS THEY WERE when this shipment was quoted
  /// or booked.
  ///
  /// WHY A COPY, WHEN THE WHOLE POINT OF PickupLocation IS NOT TO COPY. The
  /// shared record is the source of truth for quoting; this is evidence. An
  /// operator correcting a dock's postal code next month must not silently
  /// rewrite where a parcel booked last week was collected from — the label,
  /// the carrier's record and the audit trail would then disagree with our own
  /// history. So the snapshot freezes the quotation-time facts, and the live
  /// row governs anything new.
  originSnapshot          Json?
  /// The packages as quoted or booked: type, packed L/W/H in inches, weight in
  /// pounds, count and the item quantities allocated to each. Frozen for the
  /// same reason as the origin, so a later packaging edit cannot retroactively
  /// change what was sent.
  packageSnapshot         Json?
  /// The parcels this shipment was actually booked with, when the operator
  /// linked them. `packageSnapshot` remains the frozen evidence of what was
  /// sent; this is the live link back to the rows the seller's order carries.
  packages                OrderPackage[]          @relation("ShipmentPackages")
  items                   ShipmentItem[]
  trackingEvents          ShipmentTrackingEvent[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([returnOfShipmentId])
  @@index([originLocationId])
}

/// Every raw carrier event a provider returns, stored append-only so the UI can
/// show provider detail while still normalizing into a friendly status. Events
/// are keyed so a redelivered poll cannot insert the same event twice, and an
/// older event can never overwrite a newer normalized state.
model ShipmentTrackingEvent {
  id               String   @id @default(cuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventKey         String
  eventAt          DateTime
  location         String?
  description      String?
  carrierEventCode String?
  statusText       String?
  proofOfDelivery  String?
  createdAt        DateTime @default(now())

  @@unique([shipmentId, eventKey])
  @@index([shipmentId, eventAt])
}

/// The coarse lifecycle of a parcel, and the booking's own outcome.
///
/// WHY BOOKING STATES ARE SEPARATE FROM SHIPPING STATES. A booking can fail, or
/// it can end without an answer — the provider was asked and never replied. Those
/// are facts about the PURCHASE, and neither of them is "PENDING": a PENDING
/// shipment with a label is one thing, and a shipment whose booking outcome
/// nobody knows is another, and the second must never be retried blind. Keeping
/// them distinct is what lets the UI say "Booking outcome unknown — reconcile"
/// instead of offering a button that might buy a second label.
enum ShipmentStatus {
  /// Prepared, not yet sent to the provider.
  PENDING
  /// In flight at the provider: a booking call is out and no answer has come
  /// back. A shipment found in this state has no answer rather than no booking.
  BOOKING
  /// The provider accepted the booking. Documents exist; the parcel has NOT
  /// necessarily been collected.
  BOOKED
  /// The provider refused. Safe to retry: nothing was purchased.
  BOOKING_FAILED
  /// The call did not return a usable answer (timeout, connection reset). A
  /// booking may or may not exist, so this state is reconciled, never retried.
  BOOKING_UNKNOWN
  /// A cancellation has been sent and not yet confirmed.
  CANCELLING
  SHIPPED
  DELIVERED
  EXCEPTION
  CANCELLED
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime  @default(now())
}

/// The append-only security and activity log.
///
/// Append-only is enforced in the database, not by convention: a migration
/// installs a trigger that raises on UPDATE and DELETE against this table. That
/// matters because the application connects as the role that owns the schema,
/// so revoking UPDATE/DELETE from it would be meaningless — the owner can grant
/// the privilege straight back. A trigger applies to every role, including the
/// owner and including a future careless migration.
///
/// Security events use `action` values prefixed "security.". The acting user is
/// actorId; the subject of the action, where there is one, is entityId with
/// entityType "AdminUser". Nothing here may hold a secret, a password, a hash,
/// a session token or an invitation token — see recordAudit() callers.
model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String
  actorName  String?
  action     String
  entityType String
  entityId   String
  beforeData String?
  afterData  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum ActorType {
  ADMIN_USER
  SYSTEM
  MERCHANT
  WEBHOOK
}

