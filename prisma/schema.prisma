// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OwnerUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          OwnerRole @default(OWNER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  sessions      OwnerSession[]
  reviewedApplications MerchantApplication[] @relation("ReviewedApplications")
  auditLogs     AuditLog[] @relation("AuditLogs")
}

model OwnerSession {
  id           String     @id @default(cuid())
  userId       String
  user         OwnerUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  lastAccessAt DateTime   @default(now())
}

enum OwnerRole {
  OWNER
  OPERATIONS
  REVIEWER
  READONLY
}

model MerchantApplication {
  id                    String                @id @default(cuid())
  shopDomain            String                @unique
  storeName             String
  shopifyPlan           String?
  storeUrl              String?
  country               String?
  currency              String?
  contactName           String
  email                 String
  phone                 String?
  urgentPhone           String?
  legalBusinessName     String
  sellerAddress         String
  gstHstNumber          String?
  productCategory       String
  markets               String                @default("[]")
  status                ApplicationStatus     @default(PENDING)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            OwnerUser?            @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  rejectionReason       String?
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  shopifyStoreProfile   String?               @default("{}")
  shopifySalesReview    String?               @default("{}")
  merchantContact       String?               @default("{}")
  seller                Seller?
  auditLogs             AuditLog[]

  @@index([status])
  @@index([shopDomain])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
}

model Seller {
  id                    String        @id @default(cuid())
  shopDomain            String        @unique
  storeName             String
  shopDomainFull        String
  contactEmail          String
  contactName           String?
  phone                 String?
  country               String?
  currency              String        @default("CAD")
  shopifyPlan           String?
  storeUrl              String?
  applicationId         String?       @unique
  application           MerchantApplication? @relation(fields: [applicationId], references: [id])
  status                SellerStatus  @default(PENDING)
  approvedAt            DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  lastSyncAt            DateTime?
  syncStatus            SyncStatus    @default(NEVER)
  products              SellerProduct[]
  orders                Order[]
  auditLogs             AuditLog[]
  settings              SellerSettings?

  @@index([status])
  @@index([shopDomain])
}

enum SellerStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
  UNINSTALLED
}

enum SyncStatus {
  NEVER
  SYNCING
  SUCCESS
  FAILED
}

model SellerSettings {
  id                    String   @id @default(cuid())
  sellerId              String   @unique
  seller                Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  autoSyncInventory     Boolean  @default(true)
  quantityBuffer        Int      @default(5)
  lowStockAlerts        Boolean  @default(true)
  autoImportOrders      Boolean  @default(true)
  estimatedDeliveryMsg  String   @default("Typically ships within 2–4 business days.")
  defaultMarkup         Int      @default(200)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  description           String?
  category              String
  sku                   String            @unique
  wholesalePrice        Int
  suggestedRetailPrice  Int
  costPrice             Int?
  images                String            @default("[]")
  categoryId            String?
  categoryRef           Category?         @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  sellerProducts        SellerProduct[]
  orderItems            OrderItem[]       @relation("OrderItemProduct")
  isActive              Boolean           @default(true)
  isArchived            Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([category])
  @@index([sku])
  @@index([isActive])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String    @unique
  name              String
  wholesalePrice    Int
  suggestedRetailPrice Int
  costPrice         Int?
  inventory         Int       @default(0)
  weight            Int?
  dimensions        String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orderItems        OrderItem[] @relation("OrderItemVariant")
}

model SellerProduct {
  id                    String        @id @default(cuid())
  sellerId              String
  seller                Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyProductId      String?
  shopifyVariantIds     String        @default("[]")
  importedAt            DateTime?
  isActive              Boolean       @default(true)
  customWholesalePrice  Int?
  customRetailPrice     Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  orderItems            OrderItem[]   @relation("OrderItemSellerProduct")

  @@unique([sellerId, productId])
  @@index([sellerId])
  @@index([productId])
}

model Order {
  id                    String        @id @default(cuid())
  sellerId              String
  seller                Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopifyOrderId        String
  shopifyOrderName      String
  shopifyOrderNumber    Int
  customerEmail         String?
  customerName          String?
  customerPhone         String?
  shippingAddress       String?
  billingAddress        String?
  currency              String        @default("CAD")
  subtotal              Int
  totalTax              Int
  totalShipping         Int
  totalDiscounts        Int
  totalPrice            Int
  moonvellaSubtotal     Int
  moonvellaTax          Int
  moonvellaShipping     Int
  moonvellaDiscounts    Int
  moonvellaTotal        Int
  paymentStatus         PaymentStatus @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(PENDING)
  financialStatus       String?
  shopifyCreatedAt      DateTime
  shopifyUpdatedAt      DateTime
  processedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  items                 OrderItem[]
  refunds               Refund[]
  shipments             Shipment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([shopifyCreatedAt])
  @@index([processedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIAL
}

model OrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?      @relation("OrderItemProduct", fields: [productId], references: [id])
  variantId             String?
  variant               ProductVariant? @relation("OrderItemVariant", fields: [variantId], references: [id])
  sellerProductId       String?
  sellerProduct         SellerProduct? @relation("OrderItemSellerProduct", fields: [sellerProductId], references: [id])
  shopifyLineItemId     String
  name                  String
  sku                   String
  quantity              Int
  price                 Int
  wholesalePrice        Int
  totalDiscount         Int
  isMoonvellaProduct    Boolean       @default(true)
  createdAt             DateTime      @default(now())
  refundItems           RefundItem[]
  shipmentItems         ShipmentItem[]
}

model Refund {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId       String
  amount                Int
  reason                String?
  processedAt           DateTime
  items                 RefundItem[]
  createdAt             DateTime      @default(now())
}

model RefundItem {
  id              String      @id @default(cuid())
  refundId        String
  refund          Refund      @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  amount          Int
  reason          String?
  createdAt       DateTime    @default(now())
}

model Shipment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyFulfillmentId  String?
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  status                ShipmentStatus @default(PENDING)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  items                 ShipmentItem[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  EXCEPTION
  CANCELLED
}

model ShipmentItem {
  id              String      @id @default(cuid())
  shipmentId      String
  shipment        Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  createdAt       DateTime    @default(now())
}

model AuditLog {
  id                String      @id @default(cuid())
  actorType         ActorType
  actorId           String
  actorName         String?
  action            String
  entityType        String
  entityId          String
  beforeData        String?
  afterData         String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime    @default(now())

  application       MerchantApplication? @relation(fields: [entityId], references: [id])
  seller            Seller?           @relation(fields: [entityId], references: [id])
  actor             OwnerUser?        @relation("AuditLogs", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum ActorType {
  OWNER_USER
  SYSTEM
  MERCHANT
  WEBHOOK
}

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String
  province              String
  supplierShippingCost  Int
  transit               String
  freeShippingThreshold Int
  customerDisplay       String
  status                String   @default("Active")
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WebhookEvent {
  id                    String   @id @default(cuid())
  shopDomain            String
  topic                 String
  payload               String
  status                WebhookStatus @default(PENDING)
  errorMessage          String?
  processedAt           DateTime?
  retryCount            Int      @default(0)
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())

  @@index([shopDomain, topic])
  @@index([status])
  @@index([idempotencyKey])
}

enum WebhookStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}