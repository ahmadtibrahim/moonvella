// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Production runs on PostgreSQL. The SQLite datasource this replaced could not
// be carried forward: its migrations are SQLite-flavoured SQL that PostgreSQL
// rejects, so a fresh baseline was generated instead (see
// prisma/migrations-sqlite-legacy/ for the retired history, kept for reference
// only and never applied).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// An administrative identity for the owner panel.
///
/// This was called OwnerUser while the panel had exactly one account. It now
/// holds every staff member, and an OPERATIONS or VIEWER user is not an owner,
/// so the name follows the job. The rename cost nothing at the moment it was
/// made: the table held zero rows.
model AdminUser {
  id                 String    @id @default(cuid())
  /// Always stored trimmed and lower-cased, and sign-in normalises the same
  /// way, so "A@B.com" and "a@b.com" can never become two accounts.
  email              String    @unique
  name               String
  /// Null until an invitation is accepted. A pending invitee therefore holds no
  /// credential at all, rather than a placeholder that could be guessed.
  passwordHash       String?
  role               AdminRole @default(VIEWER)
  isActive           Boolean   @default(true)

  /// The primary owner. At most one row may carry this flag: the migration
  /// creates a partial unique index on it, so the invariant is enforced by the
  /// database and not only by the application code that happens to respect it.
  isPrimaryOwner     Boolean   @default(false)

  /// Set when the invited person proves control of the address by accepting.
  /// Distinguishes a proven address from one an operator merely typed in.
  emailVerifiedAt    DateTime?
  /// Forces a password change at next sign-in. Used for recovery, not by the
  /// ordinary invitation flow.
  mustChangePassword Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  /// Durable per-account failure tally, surfaced in the user list. LoginAttempt
  /// remains the source of truth for throttling; this is the visible counter.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  /// Who created the account. Null for the primary owner, who is created by the
  /// CLI and has no creator.
  createdById        String?
  createdBy          AdminUser? @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       AdminUser[] @relation("CreatedUsers")

  sessions           AdminSession[]
  invitationsSent    AdminInvitation[] @relation("InvitedBy")
  reviewedApplications MerchantApplication[] @relation("ReviewedApplications")

  @@index([isActive])
  @@index([role])
}

/// A signed-in session.
///
/// The token itself is NOT stored — only its SHA-256 digest. A copy of this
/// table (a backup, a replica, a query that reads one row) therefore yields no
/// usable credential, because the digest cannot be replayed as a cookie. The
/// raw token exists only in the client's cookie and in the request that set it.
///
/// SHA-256 is the right choice here rather than bcrypt: the token is 256 bits
/// of CSPRNG output, not a human-chosen password, so there is no dictionary to
/// attack and no work factor worth adding. The hash is verified on every
/// authenticated request, where a slow KDF would be a self-inflicted denial of
/// service.
model AdminSession {
  id           String    @id @default(cuid())
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token, hex-encoded. Never the token itself.
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastAccessAt DateTime  @default(now())
  /// Captured at sign-in, for the session list and audit correlation.
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@index([expiresAt])
}

enum AdminRole {
  OWNER
  ADMIN
  OPERATIONS
  CATALOG
  SUPPORT
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// An invitation to create a staff account.
///
/// Only the SHA-256 digest of the token is stored, for the same reason as
/// AdminSession: the digest cannot be turned back into a working link. The
/// token appears exactly once, in the URL handed to the invited person, and is
/// unrecoverable from this table afterwards — which is why the owner is offered
/// a one-time copy of the link rather than a "resend existing link" button.
model AdminInvitation {
  id          String           @id @default(cuid())
  /// Normalised exactly as AdminUser.email is.
  email       String
  name        String
  /// The role this invitation grants. Held here and never read from the
  /// acceptance request, so an invitee cannot turn a CATALOG invitation into an
  /// OWNER account by editing the form they submit.
  role        AdminRole
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  /// 24 hours from creation, checked on redemption and not only on display.
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  cancelledAt DateTime?

  invitedById String
  invitedBy   AdminUser @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status, expiresAt])
}

model MerchantApplication {
  id                    String                @id @default(cuid())
  shopDomain            String                @unique
  storeName             String
  shopifyPlan           String?
  storeUrl              String?
  country               String?
  currency              String?
  contactName           String
  email                 String
  phone                 String?
  urgentPhone           String?
  legalBusinessName     String
  sellerAddress         String
  gstHstNumber          String?
  productCategory       String
  markets               String                @default("[]")
  status                ApplicationStatus     @default(PENDING)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            AdminUser?            @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  rejectionReason       String?
  internalNotes         String?
  businessStartDate     DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  shopifyStoreProfile   String?               @default("{}")
  shopifySalesReview    String?               @default("{}")
  merchantContact       String?               @default("{}")
  seller                Seller?

  @@index([status])
  @@index([shopDomain])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
  BLOCKED
}

model Seller {
  id                    String        @id @default(cuid())
  shopDomain            String        @unique
  storeName             String
  shopDomainFull        String
  contactEmail          String
  contactName           String?
  phone                 String?
  country               String?
  currency              String        @default("CAD")
  shopifyPlan           String?
  storeUrl              String?
  applicationId         String?       @unique
  application           MerchantApplication? @relation(fields: [applicationId], references: [id])
  status                SellerStatus  @default(PENDING)
  approvedAt            DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  // Blocked is a separate state from suspended, so it gets its own columns: a
  // suspension reason that actually holds a block reason is a record that lies
  // about which control was used.
  blockedAt             DateTime?
  blockReason           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  installedAt           DateTime?
  domainRegisteredAt    DateTime?
  businessStartDate     DateTime?
  lastSyncAt            DateTime?
  syncStatus            SyncStatus    @default(NEVER)
  products              SellerProduct[]
  orders                Order[]
  wholesalePayments     WholesalePayment[]
  billingSettings       SellerBillingSettings?
  paymentMethods        SellerPaymentMethod[]
  bankAccounts          SellerBankAccount[]
  settings              SellerSettings?
  brandKit              SellerBrandKit?

  @@index([status])
  @@index([shopDomain])
}

enum SellerStatus {
  PENDING
  APPROVED
  NEEDS_INFO
  REJECTED
  SUSPENDED
  BLOCKED
  UNINSTALLED
}

enum SyncStatus {
  NEVER
  SYNCING
  SUCCESS
  FAILED
}

model SellerSettings {
  id                    String   @id @default(cuid())
  sellerId              String   @unique
  seller                Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  autoSyncInventory     Boolean  @default(true)
  quantityBuffer        Int      @default(5)
  lowStockAlerts        Boolean  @default(true)
  autoImportOrders      Boolean  @default(true)
  estimatedDeliveryMsg  String   @default("Typically ships within 2–4 business days.")
  defaultMarkup         Int      @default(200)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// A product family. It is a description, not a thing that exists in a
/// warehouse, and it is never the subject of an order line, an inventory count
/// or a storefront listing.
///
/// The flat model this replaced carried `sku`, `wholesalePrice`,
/// `suggestedRetailPrice` and `costPrice` on the product itself, which meant a
/// family with three sizes could express only one price and one stock level.
/// Those columns are gone: `sku` became the required and unique `productCode`
/// below, and the three money columns moved down to ProductVariant, where the
/// sellable unit lives. The migration copied every existing value into a
/// generated Default variant before dropping them, so nothing was lost.
///
/// `images` (a JSON array of URLs) and the ProductImage table were retired the
/// same way: both were a flat, per-product media list that could not express a
/// variant-specific image or a file shared between variants. Their URLs were
/// converted into MediaAsset rows with a shared assignment. See MediaAsset for
/// the model that replaced them.
model Product {
  id                    String            @id @default(cuid())
  name                  String
  description           String?
  category              String
  currency              String            @default("CAD")
  categoryId            String?
  categoryRef           Category?         @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  sellerProducts        SellerProduct[]
  orderItems            OrderItem[]       @relation("OrderItemProduct")
  isActive              Boolean           @default(true)
  isPublished           Boolean           @default(true)
  isArchived            Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  /// The family code. Required, unique, trimmed and upper-cased, and validated
  /// against a documented character set by app/utils/productCode.ts.
  ///
  /// Whitespace is rejected rather than stripped. Collapsing it silently would
  /// let two distinct codes become one row with no explanation shown to the
  /// person who typed it.
  ///
  /// It is deliberately NOT a variant SKU and must never be exported as one:
  /// it identifies the family, while each sellable unit has its own SKU on
  /// ProductVariant. A future Shopify import maps it to a product metafield.
  productCode      String  @unique
  /// Bulleted feature list, one per line. Stored as written; the interface
  /// renders it as a list.
  features         String?
  /// Materials and composition.
  materials        String?
  /// General care instructions for the family. A variant may add its own in a
  /// care-guide document.
  careInstructions String?

  /// The editorial state. The merchant-facing flags above are kept consistent
  /// with this by the publication gate, which is the only thing that sets
  /// either to published.
  status ProductStatus @default(DRAFT)

  /// Who created and last changed the record. Nullable because rows migrated
  /// from the flat model have no known author, and inventing one would be worse
  /// than admitting the gap.
  createdById String?
  updatedById String?

  mediaAssets      MediaAsset[]
  externalMappings ExternalProductMapping[]

  @@index([category])
  @@index([isActive])
  @@index([status])
}

// ProductImage was removed here. It was a flat list of {url, alt} rows hanging
// off the product, with no way to say "this image is for the King variant" or
// "this image is shared by all of them", and no notion of processing state,
// approval or seller visibility. Its rows were converted to MediaAsset rows
// with a shared assignment by the product/variant/media migration. The
// replacement is MediaAsset + MediaAssetAssignment.

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String    @unique
  name              String
  wholesalePrice    Int
  suggestedRetailPrice Int
  costPrice         Int?
  inventory         Int       @default(0)
  reserved          Int       @default(0)
  lowStockThreshold Int       @default(5)
  variantImageUrl   String?
  shipsSeparately   Boolean   @default(false)
  packingInstructions String?
  shippingDescription String?
  declaredValueDefault Int?
  /// Free-text dimensions from the flat model ("60x40x15"), retained verbatim
  /// rather than parsed. The migration moved `weight` into the canonical
  /// productWeightKg below, but a free-text string cannot be split into three
  /// trustworthy numbers — guessing "60x40x15" is cm and not inches would be
  /// inventing data. Kept so the value survives; the typed columns are what
  /// anything new reads.
  legacyDimensions  String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orderItems        OrderItem[] @relation("OrderItemVariant")
  sellerProductVariants SellerProductVariant[]
  packages          VariantPackage[]

  /// Optional barcode/UPC. Unique when present — a barcode identifies exactly
  /// one sellable unit — but nullable, because most variants will not have one
  /// and PostgreSQL permits many NULLs in a unique index.
  barcode String? @unique

  /// Display order within the product. Also the order the seller's storefront
  /// sees, so it is meaningful rather than cosmetic.
  sortOrder Int @default(0)

  /// The variant a single-variant product is sold as. Every product has exactly
  /// one of these after migration; see the Default-variant rule in the
  /// product/variant migration. It is a hint for the interface, not a
  /// constraint on how many variants may exist.
  isDefault Boolean @default(false)

  currency String @default("CAD")

  /// When false the variant is not stock-tracked and `inventory` is advisory.
  trackInventory Boolean @default(true)
  /// Placeholder for a future external inventory system. Never populated with
  /// a credential.
  externalInventoryRef String?

  /// How many sellable units are in one package. Distinct from
  /// VariantPackage.unitsPerPackage, which describes a shipping carton.
  unitsPerPackage Int @default(1)

  // --- unpacked product measurements -------------------------------------
  // Canonical units are centimetres and kilograms, stored as exact decimals.
  // The interface may display inches and pounds, but conversion is a display
  // concern: these columns are what every calculation, snapshot and export
  // reads, so a converted value can never quietly become the stored one.
  productLengthCm Decimal? @db.Decimal(10, 2)
  productWidthCm  Decimal? @db.Decimal(10, 2)
  productHeightCm Decimal? @db.Decimal(10, 2)
  productWeightKg Decimal? @db.Decimal(10, 3)

  variantOptions    VariantOption[]
  mediaAssignments  MediaAssetAssignment[]
  externalMappings  ExternalVariantMapping[]

  @@index([productId, sortOrder])
}

model PackagingPreset {
  id            String   @id @default(cuid())
  name          String   @unique
  packageType   String   @default("carton")
  length        Float
  width         Float
  height        Float
  dimensionUnit String   @default("cm")
  emptyWeight   Float?
  weightUnit    String   @default("kg")
  maxWeight     Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  packages      VariantPackage[]
}

model VariantPackage {
  id             String          @id @default(cuid())
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  label          String?
  packageType    String          @default("carton")
  presetId       String?
  preset         PackagingPreset? @relation(fields: [presetId], references: [id])
  length         Float
  width          Float
  height         Float
  dimensionUnit  String          @default("cm")
  grossWeight    Float
  weightUnit     String          @default("kg")
  unitsPerPackage Int            @default(1)
  packagesPerUnit Int            @default(1)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([variantId])
}

model SellerProduct {
  id                    String        @id @default(cuid())
  sellerId              String
  seller                Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyProductId      String?
  shopifyVariantIds     String        @default("[]")
  importedAt            DateTime?
  importStatus          SyncStatus    @default(NEVER)
  lastImportError       String?
  isActive              Boolean       @default(true)
  customWholesalePrice  Int?
  customRetailPrice     Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  orderItems            OrderItem[]   @relation("OrderItemSellerProduct")
  variantMappings       SellerProductVariant[]

  @@unique([sellerId, productId])
  @@index([sellerId])
  @@index([productId])
}

model SellerProductVariant {
  id                     String         @id @default(cuid())
  sellerProductId        String
  sellerProduct          SellerProduct  @relation(fields: [sellerProductId], references: [id], onDelete: Cascade)
  productVariantId       String
  productVariant         ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  shopifyProductId       String
  shopifyVariantId       String
  shopifyInventoryItemId String?
  shopifyLocationId      String?
  syncStatus             SyncStatus     @default(NEVER)
  syncedAt               DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([sellerProductId, productVariantId])
  @@unique([shopifyVariantId])
  @@index([sellerProductId])
}

model Order {
  id                    String        @id @default(cuid())
  sellerId              String
  seller                Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopifyOrderId        String
  shopifyOrderName      String
  shopifyOrderNumber    Int
  customerEmail         String?
  customerName          String?
  customerPhone         String?
  shippingAddress       String?
  billingAddress        String?
  currency              String        @default("CAD")
  subtotal              Int
  totalTax              Int
  totalShipping         Int
  totalDiscounts        Int
  totalPrice            Int
  moonvellaSubtotal     Int
  moonvellaTax          Int
  moonvellaShipping     Int
  moonvellaDiscounts    Int
  moonvellaTotal        Int
  paymentStatus         PaymentStatus @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(PENDING)
  financialStatus       String?
  shopifyCreatedAt      DateTime
  shopifyUpdatedAt      DateTime
  processedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  supplierReference     String?       @unique
  shopifyFulfillmentOrderId String?
  wholesalePaymentStatus WholesalePaymentStatus @default(REQUIRES_PAYMENT)
  items                 OrderItem[]
  refunds               Refund[]
  shipments             Shipment[]
  wholesalePayment      WholesalePayment?
  fulfillmentRequest    FulfillmentRequest?
  shippingQuotes        ShippingQuote[]
  packages              OrderPackage[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([shopifyCreatedAt])
  @@index([processedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIAL
}

model OrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?      @relation("OrderItemProduct", fields: [productId], references: [id])
  variantId             String?
  variant               ProductVariant? @relation("OrderItemVariant", fields: [variantId], references: [id])
  sellerProductId       String?
  sellerProduct         SellerProduct? @relation("OrderItemSellerProduct", fields: [sellerProductId], references: [id])
  shopifyLineItemId     String
  name                  String
  sku                   String
  quantity              Int
  price                 Int
  wholesalePrice        Int
  totalDiscount         Int
  isMoonvellaProduct    Boolean       @default(true)
  createdAt             DateTime      @default(now())
  refundItems           RefundItem[]
  shipmentItems         ShipmentItem[]

  // --- variant snapshot ---------------------------------------------------
  //
  // Everything below is a copy taken when the order was placed, not a live
  // read. An order must keep showing what was actually sold even after the
  // product is renamed, repriced, re-measured or archived, so nothing here is
  // ever recalculated from the current catalogue. All of it is nullable
  // because orders placed before variants existed have no variant to snapshot,
  // and a legacy row must stay readable rather than be back-filled with values
  // that would look like they were observed at the time.
  //
  // `name`, `sku`, `price` and `wholesalePrice` above are the original snapshot
  // columns and keep their meaning: product name, the SKU charged, the price
  // charged and the wholesale price charged.
  productCode     String?
  variantName     String?
  /// The ordered option pairs as they stood at purchase, JSON-encoded. A string
  /// rather than a relation for the same reason as the rest: the variant's
  /// options may be renamed or deleted afterwards.
  selectedOptions String?
  /// The seller's own list price for this variant at the time, recorded only
  /// when it differed from what was actually charged. `price` remains what the
  /// customer paid; this is the intended figure, kept so a discounted line can
  /// still explain itself. `wholesalePrice` is what MoonVella charged the
  /// seller, which is a different party and a different number.
  sellerRetailPrice Int?
  currency          String?

  /// Measurements as snapshotted, canonical cm/kg, same reasoning as above.
  productLengthCm Decimal? @db.Decimal(10, 2)
  productWidthCm  Decimal? @db.Decimal(10, 2)
  productHeightCm Decimal? @db.Decimal(10, 2)
  productWeightKg Decimal? @db.Decimal(10, 3)

  /// The shipping carton actually used, resolved from the variant's first
  /// package at order time.
  packageLengthCm  Decimal? @db.Decimal(10, 2)
  packageWidthCm   Decimal? @db.Decimal(10, 2)
  packageHeightCm  Decimal? @db.Decimal(10, 2)
  packagedWeightKg Decimal? @db.Decimal(10, 3)
  unitsPerPackage  Int?
}

model Refund {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId       String
  amount                Int
  reason                String?
  processedAt           DateTime
  items                 RefundItem[]
  createdAt             DateTime      @default(now())
}

model RefundItem {
  id              String      @id @default(cuid())
  refundId        String
  refund          Refund      @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  amount          Int
  reason          String?
  createdAt       DateTime    @default(now())
}

model Shipment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyFulfillmentId  String?
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  serviceName           String?
  serviceCode           String?
  provider              String?
  providerShipmentId    String?
  /// The provider quote id used to book, when the provider issues one. Held so a
  /// reprint or a reconciliation reads the same quote rather than re-quoting.
  providerQuoteId       String?
  labelUrl              String?
  labelDocumentFormat   String?
  /// The seller's fixed shipping charge allocated to THIS shipment. A split
  /// shipment carries only its own allocation; the order total is never repeated
  /// per parcel. Null when no allocation rule is configured.
  sellerShippingCharge  Int?
  /// The carrier cost quoted when the shipment was booked.
  quotedCarrierCost     Int?
  /// The carrier cost actually booked. Kept separate from the quote because a
  /// provider may book at a different amount than it quoted.
  bookedCost            Int?
  /// The final amount the carrier billed, once a supplier invoice is known.
  finalBilledCost       Int?
  /// Reconciliation state of the carrier cost: PENDING, RECONCILED, VARIANCE or
  /// NEEDS_RECONCILIATION. Never used to change the seller's agreed charge.
  billingStatus         String        @default("PENDING")
  /// eShipper's invoice number for the supplier bill this shipment belongs to.
  providerInvoiceNumber String?
  billingInvoices       String?
  /// Normalized tracking state for the interface, distinct from the coarse
  /// ShipmentStatus so "label created" is never reported as "shipped".
  trackingStatus        String?
  estimatedDelivery     DateTime?
  lastTrackingSyncAt    DateTime?
  lastTrackingError     String?
  /// A return shipment points at the original shipment it returns.
  returnOfShipmentId    String?
  returnReason          String?
  bookingIdempotencyKey String?       @unique
  packageCount          Int?
  status                ShipmentStatus @default(PENDING)
  labelCreatedAt        DateTime?
  packedAt              DateTime?
  handedToCarrierAt     DateTime?
  shippedAt             DateTime?
  inTransitAt           DateTime?
  deliveredAt           DateTime?
  exceptionAt           DateTime?
  cancelledAt           DateTime?
  items                 ShipmentItem[]
  trackingEvents        ShipmentTrackingEvent[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([returnOfShipmentId])
}

/// Every raw carrier event a provider returns, stored append-only so the UI can
/// show provider detail while still normalizing into a friendly status. Events
/// are keyed so a redelivered poll cannot insert the same event twice, and an
/// older event can never overwrite a newer normalized state.
model ShipmentTrackingEvent {
  id               String   @id @default(cuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventKey         String
  eventAt          DateTime
  location         String?
  description      String?
  carrierEventCode String?
  statusText       String?
  proofOfDelivery  String?
  createdAt        DateTime @default(now())

  @@unique([shipmentId, eventKey])
  @@index([shipmentId, eventAt])
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  EXCEPTION
  CANCELLED
}

model ShipmentItem {
  id              String      @id @default(cuid())
  shipmentId      String
  shipment        Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  createdAt       DateTime    @default(now())
}

/// The append-only security and activity log.
///
/// Append-only is enforced in the database, not by convention: a migration
/// installs a trigger that raises on UPDATE and DELETE against this table. That
/// matters because the application connects as the role that owns the schema,
/// so revoking UPDATE/DELETE from it would be meaningless — the owner can grant
/// the privilege straight back. A trigger applies to every role, including the
/// owner and including a future careless migration.
///
/// Security events use `action` values prefixed "security.". The acting user is
/// actorId; the subject of the action, where there is one, is entityId with
/// entityType "AdminUser". Nothing here may hold a secret, a password, a hash,
/// a session token or an invitation token — see recordAudit() callers.
model AuditLog {
  id                String      @id @default(cuid())
  actorType         ActorType
  actorId           String
  actorName         String?
  action            String
  entityType        String
  entityId          String
  beforeData        String?
  afterData         String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum ActorType {
  ADMIN_USER
  SYSTEM
  MERCHANT
  WEBHOOK
}

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String
  province              String
  supplierShippingCost  Int
  transit               String
  freeShippingThreshold Int
  customerDisplay       String
  status                String   @default("Active")
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WebhookEvent {
  id                    String   @id @default(cuid())
  shopDomain            String
  topic                 String
  payload               String
  status                WebhookStatus @default(PENDING)
  errorMessage          String?
  processedAt           DateTime?
  retryCount            Int      @default(0)
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())

  @@index([shopDomain, topic])
  @@index([status])
  @@index([idempotencyKey])
}

enum WebhookStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum WholesalePaymentStatus {
  REQUIRES_PAYMENT
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum FulfillmentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  CLOSED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  NEVER_SYNCED
  HEALTHY
  DELAYED
  FAILED
}

enum BillingMode {
  MANUAL
  AUTOMATIC
}

enum PaymentMethodStatus {
  ACTIVE
  REMOVED
  REQUIRES_ACTION
}

model WholesalePayment {
  id                      String                 @id @default(cuid())
  orderId                 String                 @unique
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId                String
  seller                  Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider                String                 @default("stripe")
  providerPaymentIntentId String?                @unique
  providerChargeId        String?
  clientSecret            String?
  paymentMethodId         String?
  billingMode             String?
  subtotal                Int?
  shippingAmount          Int?
  taxAmount               Int?
  amount                  Int
  currency                String                 @default("CAD")
  status                  WholesalePaymentStatus @default(REQUIRES_PAYMENT)
  requiresAction          Boolean                @default(false)
  failureMessage          String?
  idempotencyKey          String                 @unique
  authorizedAt            DateTime?
  capturedAt              DateTime?
  refundedAmount          Int                    @default(0)
  paidAt                  DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  events                  PaymentEvent[]
  attempts                PaymentAttempt[]

  @@index([sellerId])
  @@index([status])
}

model PaymentAttempt {
  id                      String           @id @default(cuid())
  paymentId               String
  payment                 WholesalePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider                String           @default("stripe")
  providerPaymentIntentId String?
  status                  String
  failureCode             String?
  failureMessage          String?
  requiresAction          Boolean          @default(false)
  amount                  Int
  createdAt               DateTime         @default(now())

  @@index([paymentId])
}

model SellerBillingSettings {
  id                      String      @id @default(cuid())
  sellerId                String      @unique
  seller                  Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  mode                    BillingMode @default(MANUAL)
  autoPayEnabled          Boolean     @default(false)
  maxAmountPerOrder       Int?
  maxShippingCharge       Int?
  preferredShippingPolicy String?
  holdForReview           Boolean     @default(true)
  autoBookShipment        Boolean     @default(false)
  updatedAt               DateTime    @updatedAt
  createdAt               DateTime    @default(now())
}

model SellerPaymentMethod {
  id                       String              @id @default(cuid())
  sellerId                 String
  seller                   Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider                 String              @default("stripe")
  stripeCustomerId         String?
  stripePaymentMethodId    String?             @unique
  brand                    String?
  last4                    String?
  expMonth                 Int?
  expYear                  Int?
  isDefault                Boolean             @default(false)
  status                   PaymentMethodStatus @default(ACTIVE)
  authorizationConsentAt   DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([sellerId])
}

model SellerBankAccount {
  id                   String   @id @default(cuid())
  sellerId             String
  seller               Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider             String   @default("plaid")
  plaidItemId          String?
  encryptedAccessToken String
  institutionName      String?
  accountName          String?
  accountMask          String?
  accountType          String?
  accountSubtype       String?
  status               String   @default("CONNECTED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([sellerId])
}

model ShippingQuote {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("eshipper")
  /// The provider's own quote id, when returned. Required to book via
  /// POST /api/v2/ship/{quoteId}; null for a locally-simulated quote.
  providerQuoteId   String?
  carrier           String
  serviceCode       String
  serviceName       String
  totalAmount       Int
  currency          String   @default("CAD")
  transitDays       Int?
  estimatedDelivery DateTime?
  quotedAt          DateTime @default(now())
  expiresAt         DateTime?
  selected          Boolean  @default(false)
  raw               String?
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model OrderPackage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  length    Float
  width     Float
  height    Float
  weight    Float
  units     String   @default("cm_kg")
  createdAt DateTime @default(now())

  @@index([orderId])
}

model PaymentEvent {
  id           String            @id @default(cuid())
  provider     String            @default("stripe")
  eventId      String            @unique
  type         String
  paymentId    String?
  payment      WholesalePayment? @relation(fields: [paymentId], references: [id])
  payload      String
  status       String            @default("PROCESSED")
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([paymentId])
  @@index([type])
}

model FulfillmentRequest {
  id                        String                   @id @default(cuid())
  orderId                   String                   @unique
  order                     Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyFulfillmentOrderId String?
  status                    FulfillmentRequestStatus @default(PENDING)
  requestedAt               DateTime                 @default(now())
  acceptedAt                DateTime?
  rejectedAt                DateTime?
  rejectReason              String?
  closedAt                  DateTime?
  updatedAt                 DateTime                 @updatedAt
}

model IntegrationState {
  id            String            @id @default(cuid())
  key           String            @unique
  status        IntegrationStatus @default(NOT_CONFIGURED)
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  detail        String?
  updatedAt     DateTime          @updatedAt
  /**
   * Set by an operator's Disconnect. While it is set, credential resolution
   * refuses every source for this key — including the environment — so the
   * provider cannot be reached again until someone saves credentials anew.
   * Without this, disconnecting would only change a displayed status while the
   * environment quietly kept the provider live.
   */
  disconnectedAt DateTime?
}

/**
 * Operator-supplied provider credentials, stored encrypted at rest.
 *
 * `value` is always AES-256-GCM ciphertext (see services/credentials.server.ts);
 * plaintext is never written to this table and never leaves the server. An
 * absent row means "not configured here", which lets credential resolution fall
 * back to the environment for deployments that configure providers that way.
 */
model IntegrationCredential {
  id        String   @id @default(cuid())
  key       String
  field     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, field])
  @@index([key])
}

model AnalyticsSnapshot {
  id           String    @id @default(cuid())
  shop         String
  source       String
  periodStart  DateTime?
  periodEnd    DateTime?
  coverage     String
  metrics      String    @default("{}")
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shop, source])
  @@index([shop])
}

/// Durable failed-sign-in counter. Survives a container restart, unlike the
/// in-memory map it replaces. Rows are pruned once they fall outside the window.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Idempotency ledger for externally-triggered work (Shopify webhooks, Odoo
/// writes, payment debits, shipment creation). A row is claimed before the work
/// is attempted, so a redelivered webhook or a retried request cannot create a
/// second Odoo order, payment or label.
/// Durable idempotency ledger.
///
/// Deliberately in the database rather than in process memory. The failure this
/// exists to prevent — a retry turning into a second charge against a payer's
/// bank account — most often follows a crash, a deploy, or a timeout. An
/// in-memory guard is empty in precisely that moment, so it would protect only
/// the cases that were already safe.
model IdempotencyKey {
  id          String    @id @default(cuid())
  scope       String
  key         String
  /// SHA-256 of the request parameters. Same key + different parameters is a
  /// conflict, not a replay, and must be reported rather than silently reused.
  fingerprint String
  status      String    @default("IN_PROGRESS")
  /// The recorded outcome, replayed to the caller on a repeat call.
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([scope, key])
  @@index([scope, status])
  @@index([createdAt])
}

/// A Canadian Pre-Authorized Debit mandate.
///
/// Persisted so that the mandate state machine survives a restart. `CANCELLED`
/// is terminal: a payer who revoked authorization must not be debitable because
/// the process that knew about the revocation was recycled.
model PadMandate {
  id                String   @id @default(cuid())
  sellerId          String
  state             String
  reference         String?
  payerName         String
  /// Last four digits only. Full account and transit numbers are never stored.
  accountLast4      String?
  institutionNumber String?
  transitNumber     String?
  accountType       String
  /// True when produced without contacting the provider. Never debitable.
  simulated         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerId])
  @@index([state])
}

/* ========================================================================== */
/* Product / variant / media                                                  */
/* ========================================================================== */

/// Lifecycle of a product family, independent of whether sellers can see it.
///
/// `isActive`/`isPublished`/`isArchived` predate this and are retained for the
/// merchant-facing queries that already read them; `status` is the single
/// editorial state the admin interface drives. The publication gate is what
/// keeps the two consistent — nothing sets PUBLISHED without passing it.
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

/// What an asset is for. Drives which tab it appears under and which subtype
/// values are legal for it.
enum MediaCategory {
  WHITE_BACKGROUND_IMAGE
  LIFESTYLE_IMAGE
  PRODUCT_VIDEO
  DOCUMENT
  MARKETING_CREATIVE
  EDITABLE_TEMPLATE
}

/// The finer classification within a category.
///
/// One enum across every category rather than one per category: the upload and
/// approval paths are shared, so a single column keeps the "is this asset
/// publishable" question answerable without a join per type. Values are grouped
/// below by the category they belong to, and the pairing is validated in
/// app/services/media.server.ts.
enum MediaSubtype {
  // WHITE_BACKGROUND_IMAGE
  WHITE_BACKGROUND
  // LIFESTYLE_IMAGE
  LIFESTYLE
  // PRODUCT_VIDEO
  PRODUCT_DEMO
  LIFESTYLE_VIDEO
  SOCIAL_CLIP_VERTICAL // 9:16
  SOCIAL_CLIP_SQUARE // 1:1
  // DOCUMENT
  CARE_GUIDE
  SPECIFICATION_SHEET
  WARRANTY
  CERTIFICATION
  PACKAGING_INSTRUCTIONS
  MARKETING_PDF
  OTHER_DOCUMENT
  // MARKETING_CREATIVE / EDITABLE_TEMPLATE
  SQUARE_POST // 1080 x 1080
  STORY_REEL // 1080 x 1920
  BANNER // 1600 x 600
  LANDSCAPE_AD
  SOCIAL_VIDEO
  EDITABLE_TEMPLATE
}

/// Where an upload is in its lifecycle. A seller never sees anything that is
/// not READY, whatever its approval state.
enum ProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// Editorial approval, separate from processing. DRAFT is the initial state and
/// is not a synonym for "not yet processed" — a DRAFT asset may be perfectly
/// READY and simply not yet reviewed.
enum ApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// The kinds of PDF a product can carry.
enum DocumentType {
  CARE_GUIDE
  SPECIFICATION_SHEET
  WARRANTY
  CERTIFICATION
  PACKAGING_INSTRUCTIONS
  MARKETING_PDF
  OTHER
}

/// One uploaded file, and every fact about it that is independent of which
/// variants it is shown for.
///
/// Documents and marketing creatives are rows in THIS table, not tables of
/// their own, which is why the document-only and marketing-only columns below
/// are nullable. The alternative — three asset tables — would mean three upload
/// paths, three approval paths and three implementations of the "which variants
/// does this apply to" rule, and the directive is explicit that a file shared
/// between variants is stored once. Type-specific fields are set only for the
/// category that owns them; app/services/media.server.ts enforces the pairing
/// so a DOCUMENT cannot carry a banner's dimensions.
model MediaAsset {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  MediaCategory
  subtype   MediaSubtype?
  title     String
  /// Required before publication. Enforced by the readiness checklist rather
  /// than by a NOT NULL, because an asset is legitimately created before its
  /// alt text is written.
  altText   String?

  /// What the uploader called it. Display only, never used to build a path.
  originalFilename String
  /// The opaque object key in the storage backend. Random, extension-less
  /// enough to carry no meaning, and unique so two uploads cannot collide.
  storageKey       String @unique
  mimeType         String
  fileSize         Int
  /// sha256 of the stored bytes. Used for duplicate detection and integrity.
  checksum         String

  /// Where the asset came from, for rows migrated out of the old flat model
  /// that stored a remote URL instead of a stored object. The bytes were never
  /// in our storage, so the migration cannot import them; keeping the URL means
  /// the original is still findable and the migration is not lossy. Null for
  /// anything uploaded through the normal pipeline.
  sourceUrl        String?

  width           Int?
  height          Int?
  durationSeconds Int?
  aspectRatio     String?

  processingStatus ProcessingStatus @default(UPLOADING)
  approvalStatus   ApprovalStatus   @default(DRAFT)
  /// Seller visibility is a separate switch from approval on purpose: an
  /// approved asset may still be held back from the Media Kit.
  sellerVisible    Boolean          @default(false)

  /// Video poster frame, stored as its own object.
  posterStorageKey String?

  // --- DOCUMENT only -------------------------------------------------------
  documentType  DocumentType?
  /// Human version label ("1.2"), not a sequence. History is preserved by
  /// keeping the superseded row and pointing the replacement at it.
  version       String?
  effectiveDate DateTime?
  language      String?
  /// When set, this asset supersedes that one. The superseded row is never
  /// deleted, so old versions stay traceable.
  supersedesId  String?

  // --- MARKETING_CREATIVE / EDITABLE_TEMPLATE only -------------------------
  downloadAllowed Boolean @default(true)
  instructions    String?
  /// An approved external link for an editable template. Validated as https.
  templateUrl     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supersedes  MediaAsset?  @relation("AssetSupersession", fields: [supersedesId], references: [id])
  supersededBy MediaAsset[] @relation("AssetSupersession")
  assignments MediaAssetAssignment[]

  @@index([productId, category])
  @@index([checksum])
  @@index([approvalStatus])
}

/// Which variants an asset is shown for.
///
/// `variantId = null` means the asset is shared with every variant of the
/// product. A non-null row means it applies to that one variant; assigning to
/// several variants writes several rows pointing at the SAME asset, so the file
/// is stored once however many variants use it.
model MediaAssetAssignment {
  id        String          @id @default(cuid())
  assetId   String
  asset     MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  /// The image actually used for this variant. A primary on a shared row is the
  /// fallback used when the variant has no primary of its own; a primary on a
  /// variant row overrides it.
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())

  /// One row per (asset, scope). Re-assigning is idempotent.
  @@unique([assetId, variantId])
  @@index([variantId, sortOrder])
}

/// Ordered option name/value pairs on a variant — "Size: Queen", "Colour:
/// White". Ordered because the interface shows them in the order entered, and
/// because the SKU suggestion is built from them.
///
/// This replaces the single `optionName`/`optionValue` pair that the flat model
/// used, which could express only one axis.
model VariantOption {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int            @default(0)

  @@unique([variantId, name])
  @@index([variantId, sortOrder])
}

/// A merchant's copy of a MoonVella product in an external storefront.
///
/// Kept per shop rather than on the product, because the same product is
/// imported by several merchants and each import has its own identity, status
/// and failure history. `lastSyncError` is deliberately free text that must
/// never be given a token or credential to quote — see the audit rules.
model ExternalProductMapping {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider          String    @default("SHOPIFY")
  shopDomain        String
  externalProductId String?
  importStatus      String    @default("NOT_IMPORTED")
  lastSyncedAt      DateTime?
  lastSyncError     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, shopDomain, productId])
  @@index([shopDomain])
}

/// The variant-level counterpart of ExternalProductMapping. The Shopify variant
/// id is the one the merchant's inventory is keyed on, so this row — not the
/// product row — is what a future inventory sync reconciles against.
model ExternalVariantMapping {
  id                String         @id @default(cuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  provider          String         @default("SHOPIFY")
  shopDomain        String
  externalProductId String?
  externalVariantId String?
  importStatus      String         @default("NOT_IMPORTED")
  lastSyncedAt      DateTime?
  lastSyncError     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([provider, shopDomain, variantId])
  @@index([shopDomain])
}

/// Per-seller branding used when generating marketing material.
///
/// Nothing reads this yet. It exists now because the Marketing Pack generator
/// has to be written against a shape, and retrofitting the seller's brand into
/// generated assets after merchants have downloaded them is not possible.
model SellerBrandKit {
  id        String   @id @default(cuid())
  sellerId  String   @unique
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeName String?
  /// Object key of the seller's logo, in the same storage backend as media.
  logoStorageKey String?
  callToAction   String?
  /// JSON object of named colours, e.g. {"primary":"#1B4D3E"}. A free-form map
  /// because brands do not agree on a palette size.
  brandColours   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}