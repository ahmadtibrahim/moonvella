{
  "name": "moon-vella",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.js",
    "start:stock": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "create-admin": "node scripts/create-admin.mjs",
    "seed:test-product": "node scripts/run-verify.mjs scripts/seed-test-product.ts",
    "seed-catalog": "node scripts/seed-catalog.mjs",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:rankings": "node scripts/run-verify.mjs scripts/verify-rankings.ts",
    "verify:orders": "node scripts/run-verify.mjs scripts/verify-orders.ts",
    "verify:payments": "node scripts/run-verify.mjs scripts/verify-payments.ts",
    "verify:wholesale": "node scripts/run-verify.mjs scripts/verify-wholesale.ts",
    "verify:packaging": "node scripts/run-verify.mjs scripts/verify-packaging.ts --seed-packaging",
    "verify:shipping": "node scripts/run-verify.mjs scripts/verify-shipping.ts",
    "verify:plaid": "node scripts/run-verify.mjs scripts/verify-plaid.ts",
    "verify:e2e": "node scripts/run-verify.mjs scripts/verify-e2e.ts",
    "verify:product-system": "node scripts/run-verify.mjs scripts/verify-product-system.ts",
    "verify:all": "node scripts/run-verify.mjs --all",
    "typecheck": "react-router typegen && tsc --noEmit",
    "verify:odoo": "node scripts/run-verify.mjs scripts/verify-odoo.ts",
    "verify:vopay": "node scripts/run-verify.mjs scripts/verify-vopay.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
